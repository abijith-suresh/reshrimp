---
import Layout from "./Layout.astro";
import "../styles/browser-primitives.css";

interface Props {
  title: string;
  description?: string;
  ogImagePath?: string;
}

const { title, description, ogImagePath } = Astro.props;
---

<Layout
  title={title}
  description={description}
  ogImagePath={ogImagePath}
  viewportFitCover
  preloadDisplayFont={false}
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <slot />
</Layout>
