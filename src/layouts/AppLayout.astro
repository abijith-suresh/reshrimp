---
import Layout from "./Layout.astro";
import AppHeader from "../components/app/AppHeader.astro";

interface Props {
  title: string;
  description?: string;
  ogImagePath?: string;
}

const { title, description, ogImagePath } = Astro.props;
---

<Layout title={title} description={description} ogImagePath={ogImagePath}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <AppHeader slot="before-main" />
  <div class="flex min-h-[100dvh] flex-col">
    <div class="flex-1 min-h-0">
      <slot />
    </div>
  </div>
</Layout>
