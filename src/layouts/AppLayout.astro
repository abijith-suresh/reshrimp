---
import Layout from "./Layout.astro";
import "../styles/components.css";

interface Props {
  title: string;
  description?: string;
  ogImagePath?: string;
}

const { title, description, ogImagePath } = Astro.props;
---

<Layout title={title} description={description} ogImagePath={ogImagePath}>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <slot />
</Layout>
