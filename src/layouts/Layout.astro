---
import { ClientRouter } from "astro:transitions";
import { SITE_NAME, SITE_DESCRIPTION } from "../config/constants";
import "../styles/global.css";
import displayFontUrl from "../assets/fonts/BricolageGrotesque-Bold.woff2?url";
import bodyFontUrl from "../assets/fonts/PlusJakartaSans-Regular.woff2?url";
import bodySemiboldFontUrl from "../assets/fonts/PlusJakartaSans-SemiBold.woff2?url";

interface Props {
  title: string;
  description?: string;
  ogImagePath?: string;
  viewportFitCover?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImagePath,
  viewportFitCover = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

function deriveOgImagePath(pathname: string): string {
  const stripped = pathname.replace(new RegExp(`^${base}`), "").replace(/^\/|\/$/g, "");
  const route = stripped || "index";
  return `${base}/og/${route}.png`;
}

const ogImage = new URL(ogImagePath ?? deriveOgImagePath(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content={
        viewportFitCover
          ? "width=device-width, initial-scale=1, viewport-fit=cover"
          : "width=device-width, initial-scale=1"
      }
    />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodySemiboldFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#f8f7ff" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Per-page head content -->
    <slot name="head" />

    <!-- SPA Navigation -->
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main-content"
      data-global-skip-link
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 p-2 bg-coral-500 text-white rounded-md font-semibold"
      style={
        viewportFitCover
          ? {
              top: "calc(env(safe-area-inset-top, 0px) + 1rem)",
              left: "calc(env(safe-area-inset-left, 0px) + 1rem)",
            }
          : undefined
      }
    >
      Skip to main content
    </a>
    <slot name="before-main" />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <slot name="after-main" />
  </body>
</html>

<script>
  import { registerPageInitializer } from "../lib/pageInitializer";

  // ── Scroll reveal via Intersection Observer ──────────────────────────
  function initReveal() {
    const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (!els.length) return;

    // If a script starts after the browser has painted, don't hide visible
    // content and then reveal it again. Keep the first viewport settled while
    // retaining scroll reveals for content farther down the page.
    const viewportHeight = window.innerHeight;
    els.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < viewportHeight && rect.bottom > 0) {
        el.classList.add("revealed");
      }
    });

    document.documentElement.classList.add("reveal-ready");

    // Apply staggered delays from data-reveal-delay attribute
    els.forEach((el) => {
      const delay = el.dataset.revealDelay;
      if (delay) el.style.transitionDelay = `${delay}ms`;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px" }
    );

    els.forEach((el) => observer.observe(el));

    return () => {
      observer.disconnect();
      document.documentElement.classList.remove("reveal-ready");
    };
  }

  registerPageInitializer("layout:interactions", () => {
    const cleanups = [initReveal()].filter(
      (cleanup): cleanup is () => void => typeof cleanup === "function"
    );

    return () => {
      cleanups.forEach((cleanup) => cleanup());
    };
  });
</script>
