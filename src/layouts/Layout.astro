---
import { ClientRouter } from "astro:transitions";
import { SITE_NAME, SITE_DESCRIPTION } from "../config/constants";
import { OG_IMAGE_VERSION } from "../config/ogData";
import "../styles/global.css";
import displayFontUrl from "../assets/fonts/BricolageGrotesque-Bold.woff2?url";
import bodyFontUrl from "../assets/fonts/PlusJakartaSans-Regular.woff2?url";
import bodySemiboldFontUrl from "../assets/fonts/PlusJakartaSans-SemiBold.woff2?url";

interface Props {
  title: string;
  description?: string;
  ogImagePath?: string;
  noindex?: boolean;
  viewportFitCover?: boolean;
  preloadDisplayFont?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImagePath,
  noindex = false,
  viewportFitCover = false,
  preloadDisplayFont = true,
  bodyClass,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

function deriveOgImagePath(pathname: string): string {
  const stripped = pathname.replace(new RegExp(`^${base}`), "").replace(/^\/|\/$/g, "");
  const route = stripped || "index";
  return `${base}/og/${route}-${OG_IMAGE_VERSION}.png`;
}

const ogImage = new URL(ogImagePath ?? deriveOgImagePath(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content={
        viewportFitCover
          ? "width=device-width, initial-scale=1, viewport-fit=cover"
          : "width=device-width, initial-scale=1"
      }
    />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#ffffff" />

    {preloadDisplayFont && (
      <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    )}
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodySemiboldFontUrl} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Per-page head content -->
    <slot name="head" />

    <!-- SPA Navigation -->
    <ClientRouter />
  </head>
  <body class:list={["bg-canvas font-body text-fg antialiased", bodyClass]}>
    <a
      href="#main-content"
      data-global-skip-link
      class:list={[
        "sr-only focus:not-sr-only focus:absolute z-200 rounded-md bg-primary px-4 py-2.5 font-semibold text-primary-fg",
        viewportFitCover
          ? "focus:top-[calc(env(safe-area-inset-top,0px)+1rem)] focus:left-[calc(env(safe-area-inset-left,0px)+1rem)]"
          : "focus:top-4 focus:left-4",
      ]}
    >
      Skip to main content
    </a>
    <slot name="before-main" />
    <main id="main-content" class="flex-1" transition:animate="fade">
      <slot />
    </main>
    <slot name="after-main" />
  </body>
</html>
