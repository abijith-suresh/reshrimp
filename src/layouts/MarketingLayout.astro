---
import Layout from "./Layout.astro";
import MarketingHeader from "../components/shared/MarketingHeader.astro";
import MarketingFooter from "../components/shared/MarketingFooter.astro";

interface Props {
  title: string;
  description?: string;
  ogImagePath?: string;
  noindex?: boolean;
  currentPath?: string;
}

const { title, description, ogImagePath, noindex, currentPath = "/" } = Astro.props;
---

<Layout
  title={title}
  description={description}
  ogImagePath={ogImagePath}
  noindex={noindex}
  bodyClass="flex min-h-dvh flex-col overflow-x-clip"
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <MarketingHeader slot="before-main" currentPath={currentPath} />
  <slot />
  <MarketingFooter slot="after-main" />
</Layout>
