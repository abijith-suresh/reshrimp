---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import MarketingPageWrapper from "../components/marketing/layout/MarketingPageWrapper.astro";
import MarketingContainer from "../components/marketing/layout/MarketingContainer.astro";
import HeroSection from "../components/marketing/hero/HeroSection.astro";
import MarketingContentBlock from "../components/marketing/cards/MarketingContentBlock.astro";
import TechStackGrid from "../components/marketing/cards/TechStackGrid.astro";
import TechStackItem from "../components/marketing/cards/TechStackItem.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import PageSection from "../components/ui/PageSection.astro";
import { Github } from "lucide-astro";
import { makeHref } from "../lib/utils";
import { GITHUB_URL, ROUTES } from "../config/constants";

const ABOUT_CARDS = [
  {
    title: "Why I built this",
    delay: 0,
    paragraphs: [
      "Most online image tools upload the file before they do the work. That adds waiting, file limits, and another service handling your image.",
      "Reshrimp uses browser APIs instead. It stays focused on one image at a time: resize, convert, compress, or remove a background.",
    ],
  },
  {
    title: "The tech stack",
    delay: 100,
    paragraphs: ["A small static site and browser app. Each part has one job."],
    hasTechStack: true,
  },
  {
    title: "Privacy by default",
    delay: 200,
    paragraphs: [
      "Your image stays in the browser. Reshrimp does not upload it, track it, or log it.",
      "Background removal also runs on your device when you use it. The code is open source, so you can check how it works.",
    ],
  },
  {
    title: "Open source",
    delay: 300,
    paragraphs: [
      "Read the code, run your own copy, or send a fix. Reshrimp is licensed under MIT.",
    ],
    hasButtons: true,
  },
];
---

<MarketingLayout
  title="Reshrimp | About"
  description="Why Reshrimp is a small, open source image tool that runs in your browser."
  currentPath="/about"
>
  <MarketingPageWrapper>
    <HeroSection
      title="A small image tool that stays simple."
      subtitle="Resize, convert, compress, and remove backgrounds in your browser."
    />

    <PageSection>
      <MarketingContainer>
        {
          ABOUT_CARDS.map((card) => (
            <MarketingContentBlock delay={card.delay}>
              <h2>{card.title}</h2>
              {card.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
              {card.hasTechStack && (
                <TechStackGrid>
                  <TechStackItem name="Astro" description="Static site" />
                  <TechStackItem name="Solid.js" description="Interactive app UI" />
                  <TechStackItem name="TypeScript" description="Image processing" />
                  <TechStackItem name="Tailwind CSS" description="Shared styles" />
                  <TechStackItem name="Vercel" description="Deployment" />
                  <TechStackItem name="Vitest" description="Tests" />
                </TechStackGrid>
              )}
              {card.hasButtons && (
                <div class="flex items-center gap-3 mt-5 flex-wrap">
                  <ButtonLink href={GITHUB_URL} variant="secondary" external={true}>
                    <Github size={18} aria-hidden="true" />
                    View on GitHub
                  </ButtonLink>
                  <ButtonLink href={makeHref(ROUTES.APP)}>
                    Choose an image
                  </ButtonLink>
                </div>
              )}
            </MarketingContentBlock>
          ))
        }
      </MarketingContainer>
    </PageSection>
  </MarketingPageWrapper>
</MarketingLayout>
