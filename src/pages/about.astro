---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Card from "../components/marketing/cards/Card.astro";
import Row from "../components/marketing/cards/Row.astro";
import PageHero from "../components/marketing/layout/PageHero.astro";
import Section from "../components/marketing/layout/Section.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import { Github } from "lucide-astro";
import { makeHref } from "../lib/utils";
import { GITHUB_URL, ROUTES } from "../config/constants";

const TECH_STACK = [
  { name: "Astro", description: "Static site" },
  { name: "Solid.js", description: "Interactive app UI" },
  { name: "TypeScript", description: "Image processing" },
  { name: "Tailwind CSS", description: "Shared styles" },
  { name: "Vercel", description: "Deployment" },
  { name: "Vitest", description: "Tests" },
];

const ABOUT_CARDS = [
  {
    title: "Why I built this",
    paragraphs: [
      "Most online image tools upload the file before they do the work. That adds waiting, file limits, and another service handling your image.",
      "Reshrimp uses browser APIs instead. It stays focused on one image at a time: resize, convert, compress, or remove a background.",
    ],
  },
  {
    title: "The tech stack",
    paragraphs: ["A small static site and browser app. Each part has one job."],
    hasTechStack: true,
  },
  {
    title: "Privacy by default",
    paragraphs: [
      "Your image stays in the browser. Reshrimp does not upload it, track it, or log it.",
      "Background removal also runs on your device when you use it. The code is open source, so you can check how it works.",
    ],
  },
  {
    title: "Open source",
    paragraphs: [
      "Read the code, run your own copy, or send a fix. Reshrimp is licensed under MIT.",
    ],
    hasButtons: true,
  },
];
---

<MarketingLayout
  title="Reshrimp | About"
  description="Why Reshrimp is a small, open source image tool that runs in your browser."
  currentPath="/about"
>
  <PageHero
    title="A small image tool that stays simple."
    lede="Resize, convert, compress, and remove backgrounds in your browser."
  />

  <Section>
    <Card class="divide-y divide-line">
      {
        ABOUT_CARDS.map((card) => (
          <Row as="section" level={2} title={card.title}>
            {card.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
            {card.hasTechStack && (
              <dl class="grid grid-cols-2 gap-x-6 marketing-mobile:grid-cols-1">
                {TECH_STACK.map((item) => (
                  <div class="flex items-baseline justify-between gap-4 border-t border-line py-2.5 text-sm">
                    <dt class="font-semibold text-fg">{item.name}</dt>
                    <dd class="text-fg-soft">{item.description}</dd>
                  </div>
                ))}
              </dl>
            )}
            {card.hasButtons && (
              <div class="flex flex-wrap items-center gap-3 pt-2 marketing-mobile:flex-col marketing-mobile:items-stretch">
                <ButtonLink href={makeHref(ROUTES.APP)}>Open Reshrimp</ButtonLink>
                <ButtonLink href={GITHUB_URL} variant="secondary" external={true}>
                  <Github size={18} aria-hidden="true" />
                  View on GitHub
                </ButtonLink>
              </div>
            )}
          </Row>
        ))
      }
    </Card>
  </Section>
</MarketingLayout>
