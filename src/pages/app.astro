---
import AppLayout from "../layouts/AppLayout.astro";
import ImageApp from "../components/app/ImageApp";
---

<AppLayout
  title="Reshrimp — Image Processor"
  description="Resize, convert, and compress images privately in your browser. No uploads, no tracking."
>
  <div
    class="grid grid-cols-[360px_1fr] max-lg:grid-cols-[300px_1fr] max-md:grid-cols-1 gap-6 max-w-[1100px] mx-auto px-8 max-lg:px-6 max-md:px-4 pt-4 pb-6 max-md:pt-3 min-h-[calc(100vh-52px)]"
    transition:animate="fade"
  >
    <ImageApp client:only="solid-js" />
  </div>
</AppLayout>
