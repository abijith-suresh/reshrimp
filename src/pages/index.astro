---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import CtaBand from "../components/marketing/cards/CtaBand.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import LandingHero from "../components/marketing/landing/LandingHero.astro";
import LandingTools from "../components/marketing/landing/LandingTools.astro";
import LandingWorkflow from "../components/marketing/landing/LandingWorkflow.astro";
import { ROUTES, SITE_DESCRIPTION, SITE_NAME } from "../config/constants";
import { makeHref } from "../lib/utils";

const siteUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: siteUrl,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: [
    "Resize by pixels, inches, or centimeters",
    "Convert to JPEG, PNG, or WebP",
    "Open HEIC, HEIF, and AVIF images",
    "Compress with a quality setting or a max file size for JPEG and WebP",
    "Remove background",
    "Processing in the browser, with no upload",
  ],
};
---

<MarketingLayout
  title="Reshrimp | Resize, compress, and convert images privately"
  description={SITE_DESCRIPTION}
  currentPath="/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <LandingHero />
  <LandingTools />
  <LandingWorkflow />
  <CtaBand
    title="Try it on an image."
    copy="Reshrimp opens in this tab. There's nothing to install."
  >
    <ButtonLink href={makeHref(ROUTES.APP)} size="lg">Open Reshrimp</ButtonLink>
  </CtaBand>
</MarketingLayout>
