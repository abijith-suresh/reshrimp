---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import MarketingPageWrapper from "../components/marketing/layout/MarketingPageWrapper.astro";
import LandingFinalCta from "../components/marketing/landing/LandingFinalCta.astro";
import LandingHero from "../components/marketing/landing/LandingHero.astro";
import LandingPrivacy from "../components/marketing/landing/LandingPrivacy.astro";
import LandingTools from "../components/marketing/landing/LandingTools.astro";
import LandingWorkflow from "../components/marketing/landing/LandingWorkflow.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../config/constants";

const siteUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: siteUrl,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: [
    "Image resizing",
    "Format conversion",
    "Image compression",
    "Background removal",
    "Local browser processing",
  ],
};
---

<MarketingLayout
  title="Reshrimp — Private image tools in your browser"
  description={SITE_DESCRIPTION}
  currentPath="/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <MarketingPageWrapper>
    <LandingHero />
    <LandingTools />
    <LandingWorkflow />
    <LandingPrivacy />
    <LandingFinalCta />
  </MarketingPageWrapper>
</MarketingLayout>
