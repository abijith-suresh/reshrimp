---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import CtaCard from "../components/marketing/cards/CtaCard.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import LandingHero from "../components/marketing/landing/LandingHero.astro";
import LandingPrivacy from "../components/marketing/landing/LandingPrivacy.astro";
import LandingTools from "../components/marketing/landing/LandingTools.astro";
import LandingWorkflow from "../components/marketing/landing/LandingWorkflow.astro";
import { ROUTES, SITE_DESCRIPTION, SITE_NAME } from "../config/constants";
import { makeHref } from "../lib/utils";

const siteUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: siteUrl,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: [
    "Image resizing",
    "Format conversion",
    "Image compression",
    "Best-effort file-size targets for JPEG, WebP, and AVIF",
    "Background removal",
    "Local browser processing",
  ],
};
---

<MarketingLayout
  title="Reshrimp | Image tools in your browser"
  description={SITE_DESCRIPTION}
  currentPath="/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <LandingHero />
  <LandingTools />
  <LandingWorkflow />
  <LandingPrivacy />
  <CtaCard
    title="Ready to change an image?"
    copy="Choose an image, make the change you need, and download the result."
  >
    <ButtonLink href={makeHref(ROUTES.APP)} size="lg">Open Reshrimp</ButtonLink>
  </CtaCard>
</MarketingLayout>
