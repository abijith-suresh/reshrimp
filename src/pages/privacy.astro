---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { Check, Github } from "lucide-astro";
import Card from "../components/marketing/cards/Card.astro";
import PageHero from "../components/marketing/layout/PageHero.astro";
import Section from "../components/marketing/layout/Section.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import { GITHUB_URL } from "../config/constants";

const CLAIMS = [
  "No upload. Your image is never sent anywhere.",
  "No account, cookies, or tracking.",
  "Saved files drop the original's location and camera data.",
  "Remove background downloads a model from this site once, about 100 MB.",
  "Reshrimp's host, Vercel, sees normal page requests like your IP address, never your image.",
  "Reshrimp needs an internet connection to open.",
];
---

<MarketingLayout
  title="Reshrimp | Privacy"
  description="Your image never leaves your device. What Reshrimp does, and what the host can see."
  currentPath="/privacy"
>
  <PageHero
    title="Your image never leaves your device."
    lede="Reshrimp edits your image inside your browser. Nothing is uploaded."
  />

  <Section>
    <div class="grid max-w-3xl grid-cols-1 gap-4">
      <Card class="p-8 marketing-mobile:p-6">
        <ul class="grid gap-4 text-lg text-fg-muted text-pretty">
          {
            CLAIMS.map((claim) => (
              <li class="flex gap-3">
                <Check size={20} strokeWidth={2.25} aria-hidden="true" class="mt-1 shrink-0 text-success" />
                {claim}
              </li>
            ))
          }
        </ul>
      </Card>

      <Card as="section" class="p-8 marketing-mobile:p-6">
        <h2 class="font-display text-title-md text-fg text-balance">Check it yourself</h2>
        <p class="mt-3 text-lg text-fg-muted text-pretty">
          Open your browser's Network tab and edit a photo. No request carries the image.
        </p>
        <div class="mt-6">
          <ButtonLink href={GITHUB_URL} variant="secondary" external={true}>
            <Github size={18} aria-hidden="true" />
            View on GitHub
          </ButtonLink>
        </div>
      </Card>
    </div>
  </Section>
</MarketingLayout>
