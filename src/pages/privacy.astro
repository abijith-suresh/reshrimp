---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import MarketingPageWrapper from "../components/marketing/layout/MarketingPageWrapper.astro";
import PageSection from "../components/ui/PageSection.astro";
import PageContainer from "../components/marketing/layout/PageContainer.astro";
import HeroSection from "../components/marketing/hero/HeroSection.astro";
import PrivacyCard from "../components/marketing/cards/PrivacyCard.astro";
import { GITHUB_URL } from "../config/constants";

const PRIVACY_CARDS = [
  {
    title: "How processing works",
    paragraphs: [
      "When you choose an image, the browser reads and changes it in memory. Reshrimp re-encodes the result before download, so uploaded metadata does not carry into the output.",
      "Background removal loads its model and runtime from this app when you use it. Your image stays in the browser.",
    ],
  },
  {
    title: "What we don't do",
    listItems: [
      "Upload images for processing",
      "Use analytics, tracking cookies, or fingerprinting",
      "Require accounts or collect personal information",
    ],
  },
  {
    title: "Open source verification",
    paragraphs: [
      "Reshrimp is open source under the MIT license. You can inspect the code instead of taking our word for it.",
      `The image-processing code lives in TypeScript services. Read it in the <a href="${GITHUB_URL}" target="_blank" rel="noopener noreferrer" class="text-coral-500 underline underline-offset-2 decoration-[rgba(242,90,90,0.3)] hover:decoration-coral-500 transition-[text-decoration-color]">GitHub repository</a>.`,
    ],
  },
  {
    title: "Third-party services",
    paragraphs: [
      "The site is static, so the first visit needs a network connection to load the app.",
      "Background removal may load model and runtime files from this app. Those are app assets, not image uploads.",
    ],
  },
];
---

<MarketingLayout
  title="Reshrimp | Privacy"
  description="How Reshrimp processes images in your browser without uploads or tracking."
  currentPath="/privacy"
>
  <MarketingPageWrapper>
    <HeroSection
      title="Your image stays in your browser."
      subtitle="Reshrimp processes images locally. It does not upload them or track you."
    />

    <PageSection>
      <PageContainer>
        {
          PRIVACY_CARDS.map((card) => (
            <PrivacyCard>
              <h2>{card.title}</h2>
              {card.paragraphs &&
                card.paragraphs.map((p) => (
                  <p set:html={p} />
                ))}
              {card.listItems && (
                <ul class="marketing-bullet-list">
                  {card.listItems.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </PrivacyCard>
          ))
        }
      </PageContainer>
    </PageSection>
  </MarketingPageWrapper>
</MarketingLayout>
