---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import MarketingPageWrapper from "../components/marketing/layout/MarketingPageWrapper.astro";
import HeroSection from "../components/marketing/hero/HeroSection.astro";
import FeatureSection from "../components/marketing/sections/FeatureSection.astro";
import CTACard from "../components/marketing/sections/CTACard.astro";
import { Scaling, ArrowLeftRight, Gauge, ShieldCheck, WifiOff, Code, Wand2 } from "lucide-astro";

const features = [
  {
    icon: Scaling,
    title: "Resize with precision",
    color: "coral",
    description:
      "Scale images to exact pixel dimensions with intelligent aspect ratio lock. Perfect for social media thumbnails, website banners, or print-ready exports. Set width, height, or both — calculator handles the math.",
  },
  {
    icon: ArrowLeftRight,
    title: "Convert between formats",
    color: "mint",
    description:
      "Switch between JPEG, PNG, and WebP with a single click. Browser-native conversion gives you format-specific tradeoffs, so you can pick WebP for the web, PNG for transparency, or JPEG for photos.",
  },
  {
    icon: Gauge,
    title: "Smart compression",
    color: "lavender",
    description:
      "Fine-tune quality from 0 to 100% before processing. Switch between original and processed previews before downloading to find the sweet spot between quality and file size.",
  },
  {
    icon: ShieldCheck,
    title: "Complete privacy",
    color: "yellow",
    description:
      "Every pixel is processed locally in your browser. No servers, no uploads, no tracking, no cookies, no accounts. Your images never leave your device. Verify it yourself — the source code is open.",
  },
  {
    icon: WifiOff,
    title: "Runs locally",
    color: "coral",
    description:
      "After the first online visit, the app shell and core tools work offline. Image processing still runs locally in your browser.",
  },
  {
    icon: Code,
    title: "Open source",
    color: "mint",
    description:
      "Built with Astro and TypeScript, licensed under MIT. Read the code, fork it, improve it, self-host it. Contributions are welcome — check the GitHub repository for open issues.",
  },
  {
    icon: Wand2,
    title: "Remove background",
    color: "lavender",
    description:
      "AI-powered background removal that runs in your browser using WebAssembly. It downloads model assets once, then works offline and exports PNG to preserve transparency.",
  },
];
---

<MarketingLayout
  title="Reshrimp — Features"
  description="Resize, convert, compress, and process images privately in your browser. Explore all features of Reshrimp."
  currentPath="/features"
>
  <MarketingPageWrapper>
    <!-- Hero -->
    <HeroSection
      chip={{ label: "Features", variant: "lavender" }}
      title="Everything you need."
      gradientTitle="Nothing you don't."
      subtitle="Reshrimp packs private image processing into a clean browser-based tool. After the first online visit, the app shell and core tools work offline."
    />

    <!-- Feature sections -->
    <section class="px-8 py-8 pb-16 relative z-10">
      <div class="max-w-[900px] mx-auto flex flex-col gap-12">
        {
          features.map((feature, i) => (
            <FeatureSection
              icon={feature.icon}
              title={feature.title}
              description={feature.description}
              color={feature.color}
              index={i}
            />
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <CTACard
      title="Ready to try it?"
      subtitle="Free, open source, private, and offline-ready after the first visit."
      background={true}
    />
  </MarketingPageWrapper>
</MarketingLayout>
