---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import MarketingPageWrapper from "../components/marketing/layout/MarketingPageWrapper.astro";
import PageSection from "../components/ui/PageSection.astro";
import HeroSection from "../components/marketing/hero/HeroSection.astro";
import FeatureSection from "../components/marketing/sections/FeatureSection.astro";
import CTACard from "../components/marketing/sections/CTACard.astro";
import { ArrowLeftRight, Gauge, Scaling, Wand2 } from "lucide-astro";

const features = [
  {
    icon: Scaling,
    title: "Resize",
    color: "coral",
    description:
      "Set the width or height, keep the original ratio when you need to, and get the exact dimensions an upload form asks for.",
  },
  {
    icon: ArrowLeftRight,
    title: "Convert",
    color: "mint",
    description:
      "Switch between JPEG, PNG, WebP, and AVIF when a site or workflow needs another format.",
  },
  {
    icon: Gauge,
    title: "Compress",
    color: "lavender",
    description: "Lower quality for a smaller file. PNG output stays lossless.",
  },
  {
    icon: Wand2,
    title: "Remove a background",
    color: "yellow",
    description:
      "Create a transparent PNG locally in your browser for a profile photo, product image, or document.",
  },
] as const;
---

<MarketingLayout
  title="Reshrimp | Features"
  description="Resize, convert, compress, and remove backgrounds in your browser."
  currentPath="/features"
>
  <MarketingPageWrapper>
    <HeroSection
      title="Four tools for one image."
      subtitle="Change the file you have, without uploading it anywhere."
    />

    <PageSection
      sectionClass="marketing-section-feature-list"
      containerClass="marketing-feature-list"
    >
      {
        features.map((feature, i) => (
          <FeatureSection
            icon={feature.icon}
            title={feature.title}
            description={feature.description}
            color={feature.color}
            index={i}
          />
        ))
      }
    </PageSection>

    <CTACard />
  </MarketingPageWrapper>
</MarketingLayout>
