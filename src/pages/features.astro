---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import MarketingPageWrapper from "../components/marketing/layout/MarketingPageWrapper.astro";
import PageSection from "../components/ui/PageSection.astro";
import HeroSection from "../components/marketing/hero/HeroSection.astro";
import FeatureSection from "../components/marketing/sections/FeatureSection.astro";
import CTACard from "../components/marketing/sections/CTACard.astro";
import { ArrowLeftRight, Gauge, Scaling, Wand2 } from "lucide-astro";

const features = [
  {
    icon: Scaling,
    title: "Resize",
    color: "coral",
    description: "Set a width, height, or percentage. Keep the original ratio when you need to.",
  },
  {
    icon: ArrowLeftRight,
    title: "Convert",
    color: "mint",
    description: "Save as JPEG, PNG, WebP, or AVIF.",
  },
  {
    icon: Gauge,
    title: "Compress",
    color: "lavender",
    description: "Adjust quality to reduce the file size. PNG stays lossless.",
  },
  {
    icon: Wand2,
    title: "Remove a background",
    color: "yellow",
    description: "Create a transparent PNG in your browser.",
  },
] as const;
---

<MarketingLayout
  title="Reshrimp | Features"
  description="Resize, convert, compress, and remove backgrounds in your browser."
  currentPath="/features"
>
  <MarketingPageWrapper>
    <HeroSection
      title="Image tools for one image."
      subtitle="Resize, convert, compress, or remove a background in your browser."
    />

    <PageSection
      sectionClass="marketing-section-feature-list"
      containerClass="marketing-feature-list"
    >
      {
        features.map((feature, i) => (
          <FeatureSection
            icon={feature.icon}
            title={feature.title}
            description={feature.description}
            color={feature.color}
            index={i}
          />
        ))
      }
    </PageSection>

    <CTACard />
  </MarketingPageWrapper>
</MarketingLayout>
