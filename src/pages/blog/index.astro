---
import { getCollection } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import FloatingShapes from "../../components/shared/FloatingShapes.astro";
import { makeHref } from "../../lib/utils";
import { ROUTES } from "../../config/constants";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<MarketingLayout
  title="Reshrimp — Blog"
  description="Guides, tips, and insights about image processing, web privacy, and browser-based tools."
  currentPath="/blog"
>
  <div class="relative overflow-x-hidden min-h-screen">
    <FloatingShapes />
    <section class="px-8 py-20 text-center relative z-10 md:px-5 md:py-12">
      <div class="max-w-[900px] mx-auto">
        <span class="pop-chip pop-chip-lavender">Blog</span>
        <h1
          class="font-display font-extrabold leading-[1.15] my-4 tracking-tight opacity-0"
          style="font-size: clamp(2rem, 5vw, 3rem); animation: popBounceIn 0.6s 0.1s forwards"
        >
          Guides & insights
        </h1>
        <p
          class="text-[1.05rem] text-sp-text-muted leading-[1.7] m-0 opacity-0"
          style="animation: popBounceIn 0.6s 0.25s forwards"
        >
          Tips on image processing, format comparisons, and the tech behind Reshrimp.
        </p>
      </div>
    </section>

    <section class="px-8 py-8 pb-20 relative z-10">
      <div class="max-w-[900px] mx-auto">
        <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6">
          {
            posts.map((post, i) => (
              <a
                href={makeHref(`${ROUTES.BLOG}/${post.id}`)}
                class="blog-card bg-sp-bg-card border border-sp-border rounded-sp-xl no-underline text-inherit transition-all duration-300 shadow-sp block hover:translate-y-[-4px] hover:shadow-sp-hover hover:border-sp-lavender"
                data-reveal
                data-reveal-delay={i * 80}
              >
                <div class="p-7 flex flex-col gap-3">
                  <div class="flex flex-wrap gap-[0.35rem]">
                    {post.data.tags.map((tag) => (
                      <span class="pop-chip pop-chip-lavender">{tag}</span>
                    ))}
                  </div>
                  <h2
                    class="font-display text-[1.15rem] font-bold m-0 leading-[1.3] tracking-tight blog-card-title"
                    transition:name={`blog-title-${post.id}`}
                  >
                    {post.data.title}
                  </h2>
                  <p class="text-[0.9rem] text-sp-text-muted leading-[1.6] m-0 blog-card-desc">
                    {post.data.description}
                  </p>
                  <div class="flex justify-between items-center text-[0.8rem] text-sp-text-soft mt-2 blog-card-meta">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {post.data.publishDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                    <span class="text-sp-coral font-medium blog-card-read">Read more &rarr;</span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  /* Reveal animations for blog cards */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px) scale(0.98);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>
