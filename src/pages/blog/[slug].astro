---
import { getCollection, render } from "astro:content";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { makeHref } from "../../lib/utils";
import { ROUTES } from "../../config/constants";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<MarketingLayout
  title={`${post.data.title} — Reshrimp Blog`}
  description={post.data.description}
  currentPath="/blog"
>
  <div class="relative min-h-screen">
    <main transition:animate="fade">
      <article class="px-8 py-8 pb-20 relative z-10">
        <div class="max-w-[720px] mx-auto">
          <!-- Back link -->
          <a
            href={makeHref(ROUTES.BLOG)}
            class="blog-back inline-block text-[0.875rem] font-medium text-sp-text-muted no-underline mb-8 transition-colors duration-200"
          >
            &larr; Back to Blog
          </a>

          <!-- Header -->
          <header class="mb-10 blog-article-header">
            <div class="flex flex-wrap gap-[0.35rem] mb-4">
              {
                post.data.tags.map((tag: string) => (
                  <span class="pop-chip pop-chip-lavender">{tag}</span>
                ))
              }
            </div>
            <h1
              class="font-display font-extrabold leading-[1.2] mb-4 tracking-tight opacity-0"
              style="font-size: clamp(1.8rem, 4.5vw, 2.5rem); animation: popBounceIn 0.6s 0.1s forwards"
              transition:name={`blog-title-${post.id}`}
            >
              {post.data.title}
            </h1>
            <div
              class="flex items-center gap-2 text-[0.875rem] text-sp-text-soft blog-article-meta opacity-0"
              style="animation: popBounceIn 0.6s 0.25s forwards"
            >
              <time datetime={post.data.publishDate.toISOString()}>
                {
                  post.data.publishDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })
                }
              </time>
              <span class="blog-article-dot text-sp-border">&middot;</span>
              <span>{post.data.author}</span>
            </div>
          </header>

          <!-- Content -->
          <div class="prose-sp">
            <Content />
          </div>

          <!-- Footer nav -->
          <div class="mt-12 pt-8 border-t border-sp-border blog-article-footer">
            <a
              href={makeHref(ROUTES.BLOG)}
              class="blog-back inline-block text-[0.875rem] font-medium text-sp-text-muted no-underline transition-colors duration-200"
            >
              &larr; Back to Blog
            </a>
          </div>
        </div>
      </article>
    </main>
  </div>
</MarketingLayout>

<style>
  .blog-back:hover {
    color: var(--sp-coral);
  }
</style>
