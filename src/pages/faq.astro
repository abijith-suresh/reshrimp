---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Card from "../components/marketing/cards/Card.astro";
import CtaCard from "../components/marketing/cards/CtaCard.astro";
import PageHero from "../components/marketing/layout/PageHero.astro";
import Section from "../components/marketing/layout/Section.astro";
import FAQAccordion from "../components/marketing/sections/FAQAccordion.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import { Github } from "lucide-astro";
import { makeHref } from "../lib/utils";
import { GITHUB_URL, ROUTES } from "../config/constants";

const faqs = [
  {
    question: "Is Reshrimp free?",
    answer: "Yes. It has no account or paid tier. The code is open source under the MIT license.",
  },
  {
    question: "How does privacy work?",
    answer:
      "All image processing happens in your browser. Reshrimp does not upload your image, use analytics, or track you. Background removal loads its model and runtime from this app when you use it.",
  },
  {
    question: "What image formats are supported?",
    answer:
      "Reshrimp reads JPEG, PNG, WebP, AVIF, HEIC, and HEIF. You can export JPEG, PNG, WebP, or AVIF.",
  },
  {
    question: "What's the maximum file size?",
    answer:
      "The upload limit is 50MB per image. For JPEG, WebP, and AVIF output, you can also set a maximum file size in the editor. Reshrimp adjusts quality to try to meet it, but the target is best effort; your device's available memory can also reduce the practical upload limit.",
  },
  {
    question: "Where's the source code?",
    answer: `The project is open source on <a href="${GITHUB_URL}" target="_blank" rel="noopener noreferrer">GitHub</a>. The image-processing code lives in TypeScript services.`,
  },
  {
    question: "Can I use it for commercial purposes?",
    answer:
      "Yes. You can use Reshrimp and the images you process with it for commercial work. The tool is MIT-licensed.",
  },
  {
    question: "How do the quality settings work?",
    answer:
      "The quality slider controls JPEG, WebP, and AVIF output from 0 to 100%. Or set a maximum output size and let Reshrimp adjust quality for you. It may not be possible to meet every target; the editor reports when the smallest result is still over the limit. PNG and transparent background-removal exports stay lossless. The preview updates after processing so you can review the result before downloading.",
  },
];
---

<MarketingLayout
  title="Reshrimp | FAQ"
  description="Answers about Reshrimp, including privacy, formats, file limits, and processing."
  currentPath="/faq"
>
  <PageHero title="Questions about Reshrimp." lede="Privacy, formats, file limits, and processing." />

  <Section>
    <Card class="px-6 marketing-mobile:px-5">
      {faqs.map((faq) => <FAQAccordion question={faq.question} answer={faq.answer} />)}
    </Card>
  </Section>

  <CtaCard title="Still have a question?" copy="Read the source or try the tool.">
    <ButtonLink href={makeHref(ROUTES.APP)}>Open Reshrimp</ButtonLink>
    <ButtonLink href={GITHUB_URL} variant="secondary" external={true}>
      <Github size={18} aria-hidden="true" />
      View on GitHub
    </ButtonLink>
  </CtaCard>
</MarketingLayout>
