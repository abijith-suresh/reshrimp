---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Card from "../components/marketing/cards/Card.astro";
import CtaBand from "../components/marketing/cards/CtaBand.astro";
import PageHero from "../components/marketing/layout/PageHero.astro";
import Section from "../components/marketing/layout/Section.astro";
import FAQAccordion from "../components/marketing/sections/FAQAccordion.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import { Github } from "lucide-astro";
import { makeHref } from "../lib/utils";
import { GITHUB_URL, ROUTES } from "../config/constants";

const github = (path: string, label: string) =>
  `<a href="${GITHUB_URL}${path}" target="_blank" rel="noopener noreferrer">${label}</a>`;

const faqs = [
  {
    question: "Is Reshrimp free?",
    answer:
      "Yes. There is no account and no paid tier. You can use the site, and the images you make with it, for any purpose, including commercial work.",
  },
  {
    question: "Is my image uploaded anywhere?",
    answer:
      "No. Reshrimp changes the image inside your browser and has no analytics or tracking. The site is hosted on Vercel, which sees ordinary request details such as your IP address when pages load, but it never receives the image.",
  },
  {
    question: "Which formats can I open and save?",
    answer:
      "Reshrimp opens JPEG, PNG, WebP, AVIF, and HEIC/HEIF, so iPhone photos work. It saves JPEG, PNG, or WebP, and HEIC photos save as JPEG unless you pick another format. If your browser cannot save the format you picked, Reshrimp tells you and saves a PNG.",
  },
  {
    question: "How big an image can I open?",
    answer:
      "Up to 50 MB, 16,384 px on each side, and 32 megapixels in total. Some 48 MP and 50 MP phone photos are over that. Take the photo at the camera's standard resolution, or open a smaller copy.",
  },
  {
    question: "Can I get a file under a certain size?",
    answer:
      "Yes, for JPEG and WebP. Set the pixel size first, then choose Max file size and enter the limit in KB, and Reshrimp lowers the quality until the file fits. The target is best effort, because Reshrimp never changes the pixel size to meet it. If the file is still too big, Reshrimp says so; reduce the pixel size or switch to JPEG and try again.",
  },
  {
    question: "How does the quality setting work?",
    answer:
      "For JPEG and WebP, quality runs from 1 to 100. Lower values make smaller files with more visible compression. PNG and background-removed images are lossless, so they have no quality setting or size target.",
  },
  {
    question: "The form asks for 300 DPI. Does Reshrimp set that?",
    answer:
      "No. The DPI setting only converts inches or cm into pixels, and it is not written into the file. If the form gives a print size, enter it in inches or cm with the DPI it asks for, and Reshrimp works out the pixels.",
  },
  {
    question: "Can I crop?",
    answer:
      "No. Reshrimp resizes the whole image. For a different shape, crop the photo in your phone's photo app first, then resize it here. If you turn off Keep aspect ratio, the image stretches to the width and height you enter.",
  },
  {
    question: "What happens to transparent areas if I save as JPEG?",
    answer: "They turn white, because JPEG has no transparency. Choose PNG or WebP to keep them.",
  },
  {
    question: "How big is the background-removal download?",
    answer:
      "About 100 MB, made up of an 88 MB model and a 12 MB runtime. Your browser downloads it from this site the first time you turn on Remove background, and shows progress while it loads. You only download it once.",
  },
  {
    question: "Which browsers work?",
    answer:
      "Automated tests run on the engines behind Chrome, Firefox, and Safari, including a mobile Chrome screen size. Remove background is tested only on Chrome's engine, so it may not work in Firefox or Safari.",
  },
  {
    question: "Is the code open source?",
    answer: `Yes, it is on ${github("", "GitHub")}, and the image processing is in ${github("/tree/main/src/services", "<code>src/services</code>")}. Reshrimp's own code is MIT-licensed. Remove background uses @imgly/background-removal, which is AGPL-3.0, and HEIC decoding uses libheif (LGPL-3.0). If you reuse or self-host the code, read those licenses first; the ${github("/blob/main/THIRD_PARTY_NOTICES.md", "third-party notices")} list them.`,
  },
];
---

<MarketingLayout
  title="Reshrimp | FAQ"
  description="Formats, limits, max file size, DPI, cropping, background removal, and what happens to your image."
  currentPath="/faq"
>
  <PageHero title="Questions about Reshrimp." lede="Formats, limits, max file size, and what happens to your image." />

  <Section>
    <Card class="px-8 marketing-mobile:px-6">
      {faqs.map((faq) => <FAQAccordion question={faq.question} answer={faq.answer} />)}
    </Card>
  </Section>

  <CtaBand
    title="Question not answered here?"
    copy="Open an issue on GitHub, or try Reshrimp with your own image."
  >
    <ButtonLink href={makeHref(ROUTES.APP)}>Open Reshrimp</ButtonLink>
    <ButtonLink href={`${GITHUB_URL}/issues`} variant="secondary" external={true}>
      <Github size={18} aria-hidden="true" />
      Open an issue
    </ButtonLink>
  </CtaBand>
</MarketingLayout>
