---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Card from "../components/marketing/cards/Card.astro";
import CtaBand from "../components/marketing/cards/CtaBand.astro";
import PageHero from "../components/marketing/layout/PageHero.astro";
import Section from "../components/marketing/layout/Section.astro";
import FAQAccordion from "../components/marketing/sections/FAQAccordion.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import { Github } from "lucide-astro";
import { makeHref } from "../lib/utils";
import { GITHUB_URL, ROUTES } from "../config/constants";

const faqs = [
  {
    question: "Is Reshrimp free?",
    answer: "Yes. There is no account or paid tier, and you can use the results for anything.",
  },
  {
    question: "Is my image uploaded?",
    answer: `No. It never leaves your device. The <a href="${makeHref(ROUTES.PRIVACY)}">privacy page</a> shows how to check.`,
  },
  {
    question: "Can I get a file under a certain size?",
    answer:
      "Yes, for JPEG and WebP. Enter the limit under Max file size. If Reshrimp can't reach it, make the pixel size smaller.",
  },
  {
    question: "The form asks for 300 DPI. Does Reshrimp set that?",
    answer: "No. DPI only turns inches or cm into pixels. It is not saved in the file.",
  },
  {
    question: "Why did my transparent background turn white?",
    answer:
      "JPEG can't store transparency, so Reshrimp fills it with white. Save as PNG or WebP to keep it.",
  },
  {
    question: "How big an image can I open?",
    answer:
      "Up to 50 MB and 32 megapixels. Photos from a phone's 48 or 50 MP mode are bigger, so use its default mode.",
  },
  {
    question: "Why is Remove background slow the first time?",
    answer: "It downloads a model of about 100 MB once. Later runs skip the download.",
  },
  {
    question: "Can I crop?",
    answer: "No. Crop in your photo app first, then resize here.",
  },
];
---

<MarketingLayout
  title="Reshrimp | FAQ"
  description="Short answers about file size limits, DPI, transparency, cropping, and privacy."
  currentPath="/faq"
>
  <PageHero title="Questions about Reshrimp." lede="Short answers about sizes, limits, and privacy." />

  <Section>
    <Card class="px-8 marketing-mobile:px-6">
      {faqs.map((faq) => <FAQAccordion question={faq.question} answer={faq.answer} />)}
    </Card>
  </Section>

  <CtaBand
    title="Question not answered here?"
    copy="Ask on GitHub, or try Reshrimp with your own photo."
  >
    <ButtonLink href={makeHref(ROUTES.APP)}>Open Reshrimp</ButtonLink>
    <ButtonLink href={`${GITHUB_URL}/issues`} variant="secondary" external={true}>
      <Github size={18} aria-hidden="true" />
      Open an issue
    </ButtonLink>
  </CtaBand>
</MarketingLayout>
