---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import MarketingPageWrapper from "../components/marketing/layout/MarketingPageWrapper.astro";
import PageContainer from "../components/marketing/layout/PageContainer.astro";
import HeroSection from "../components/marketing/hero/HeroSection.astro";
import FAQAccordion from "../components/marketing/sections/FAQAccordion.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import PageSection from "../components/ui/PageSection.astro";
import { ArrowUpRight, Github } from "lucide-astro";
import { makeHref } from "../lib/utils";
import { GITHUB_URL, ROUTES } from "../config/constants";

const faqs = [
  {
    question: "Is Reshrimp free?",
    answer: "Yes. It has no account or paid tier. The code is open source under the MIT license.",
  },
  {
    question: "How does privacy work?",
    answer:
      "All image processing happens in your browser. Reshrimp does not upload your image, use analytics, or track you. Background removal loads its model and runtime from this app when you use it.",
  },
  {
    question: "What image formats are supported?",
    answer:
      "Reshrimp reads JPEG, PNG, WebP, AVIF, HEIC, and HEIF. You can export JPEG, PNG, WebP, or AVIF.",
  },
  {
    question: "What's the maximum file size?",
    answer:
      "The limit is 50MB per image. Your device's available memory can reduce the practical limit because processing happens locally.",
  },
  {
    question: "Where's the source code?",
    answer: `The project is open source on <a href="${GITHUB_URL}" target="_blank" rel="noopener noreferrer">GitHub</a>. The image-processing code lives in TypeScript services.`,
  },
  {
    question: "Can I use it for commercial purposes?",
    answer:
      "Yes. You can use Reshrimp and the images you process with it for commercial work. The tool is MIT-licensed.",
  },
  {
    question: "How do the quality settings work?",
    answer:
      "The quality slider controls JPEG, WebP, and AVIF output from 0 to 100%. PNG export stays lossless. The preview updates after processing so you can review the result before downloading.",
  },
];
---

<MarketingLayout
  title="Reshrimp | FAQ"
  description="Answers about Reshrimp, including privacy, formats, file limits, and processing."
  currentPath="/faq"
>
  <MarketingPageWrapper>
    <HeroSection
      title="Questions about Reshrimp."
      subtitle="Privacy, formats, file limits, and processing."
    />

    <PageSection sectionClass="marketing-section-faq">
      <PageContainer>
        {
          faqs.map((faq, i) => (
            <FAQAccordion question={faq.question} answer={faq.answer} delay={i * 60} />
          ))
        }
      </PageContainer>
    </PageSection>

    <PageSection
      sectionClass="marketing-section-faq-cta"
      containerClass="marketing-narrow-cta"
    >
      <h2 class="marketing-faq-cta-title" data-reveal data-reveal-delay="0">Need more detail?</h2>
      <p class="marketing-faq-cta-copy" data-reveal data-reveal-delay="80">
        Read the source or open the tool.
      </p>
      <div class="marketing-faq-cta-actions" data-reveal data-reveal-delay="160">
        <ButtonLink href={makeHref(ROUTES.APP)}>
          Open the tool
          <ArrowUpRight size={19} strokeWidth={2} aria-hidden="true" />
        </ButtonLink>
        <ButtonLink href={GITHUB_URL} variant="secondary" external={true}>
          <Github size={18} aria-hidden="true" />
          View on GitHub
        </ButtonLink>
      </div>
    </PageSection>
  </MarketingPageWrapper>
</MarketingLayout>

<style>
  .marketing-faq-cta-title {
    margin: 0;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: var(--marketing-section-size);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .marketing-faq-cta-copy {
    margin: 1.25rem 0 2rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.65;
  }

  .marketing-faq-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .marketing-faq-cta-actions :global(a[data-ui-button]) {
      width: 100%;
    }
  }
</style>
