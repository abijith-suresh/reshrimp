---
import { ArrowLeftRight, Gauge, Scaling, Wand2 } from "lucide-astro";
import LandingToolRow from "./LandingToolRow.astro";
import MarketingContainer from "../layout/MarketingContainer.astro";
import MarketingSectionHeading from "../sections/MarketingSectionHeading.astro";
---

<section class="relative z-1 py-marketing-section px-marketing-gutter" id="tools">
  <MarketingContainer>
    <MarketingSectionHeading
      title="What you can do."
    />

    <div class="flex flex-col">
      <LandingToolRow
        number="01"
        icon={Scaling}
        color="coral"
        title="Resize"
        description="Set a new width or height. Keep the original ratio when you need to."
      />
      <LandingToolRow
        number="02"
        icon={ArrowLeftRight}
        color="mint"
        title="Convert"
        description="Save as JPEG, PNG, WebP, or AVIF."
      />
      <LandingToolRow
        number="03"
        icon={Gauge}
        color="lavender"
        title="Compress"
        description="Set a maximum size; Reshrimp adjusts JPEG, WebP, or AVIF quality and reports when it cannot meet the target."
      />
      <LandingToolRow
        number="04"
        icon={Wand2}
        color="yellow"
        title="Remove a background"
        description="Make a transparent PNG in your browser."
      />
    </div>
  </MarketingContainer>
</section>
