---
import { ArrowLeftRight, Gauge, Scaling, Wand2 } from "lucide-astro";
import FeatureCard from "../cards/FeatureCard.astro";
import Section from "../layout/Section.astro";

const tools = [
  {
    icon: Scaling,
    tone: "coral",
    title: "Resize",
    description: "Exact pixels, or inches and cm at the DPI you need.",
  },
  {
    icon: ArrowLeftRight,
    tone: "mint",
    title: "Convert",
    description: "Open iPhone photos. Save as JPEG, PNG, or WebP.",
  },
  {
    icon: Gauge,
    tone: "lavender",
    title: "Compress",
    description: "Set a 50 KB limit. Reshrimp gets under it or says so.",
  },
  {
    icon: Wand2,
    tone: "yellow",
    title: "Remove background",
    description: "Cut out the subject and save it as a transparent PNG.",
  },
] as const;
---

<Section id="tools" title="What you can do.">
  <ul class="grid grid-cols-2 gap-4 marketing-mobile:grid-cols-1">
    {
      tools.map((tool) => (
        <FeatureCard icon={tool.icon} tone={tool.tone} title={tool.title}>
          <p>{tool.description}</p>
        </FeatureCard>
      ))
    }
  </ul>
</Section>
