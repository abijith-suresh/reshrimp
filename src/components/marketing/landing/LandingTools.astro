---
import { ArrowLeftRight, Gauge, Scaling, Wand2 } from "lucide-astro";
import FeatureCard from "../cards/FeatureCard.astro";
import Section from "../layout/Section.astro";

const tools = [
  {
    icon: Scaling,
    tone: "coral",
    title: "Resize",
    description:
      "Enter the width and height in pixels, or in inches or cm at a DPI you choose. Keep aspect ratio stops the photo from stretching.",
  },
  {
    icon: ArrowLeftRight,
    tone: "mint",
    title: "Convert",
    description:
      "Open JPEG, PNG, WebP, AVIF, or an iPhone HEIC photo. Save it as JPEG, PNG, or WebP if your browser supports WebP.",
  },
  {
    icon: Gauge,
    tone: "lavender",
    title: "Compress",
    description:
      "Pick a quality, or set a max file size and Reshrimp lowers JPEG or WebP quality until the file fits. The size target is best effort. If it cannot be met, Reshrimp tells you.",
  },
  {
    icon: Wand2,
    tone: "yellow",
    title: "Remove background",
    description:
      "Cut out the subject and save a transparent PNG. The first time you use it, your browser downloads about 100 MB of model files from this site, once.",
  },
] as const;
---

<Section id="tools" title="What you can do.">
  <ul class="grid grid-cols-2 gap-4 marketing-mobile:grid-cols-1">
    {
      tools.map((tool) => (
        <FeatureCard icon={tool.icon} tone={tool.tone} title={tool.title}>
          <p>{tool.description}</p>
        </FeatureCard>
      ))
    }
  </ul>
</Section>
