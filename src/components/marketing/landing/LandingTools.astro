---
import { ArrowLeftRight, Gauge, Scaling, Wand2 } from "lucide-astro";
import Card from "../cards/Card.astro";
import IconTile from "../cards/IconTile.astro";
import Section from "../layout/Section.astro";

const tools = [
  {
    icon: Scaling,
    tone: "coral",
    title: "Resize",
    description: "Set a new width or height. Keep the original ratio when you need to.",
  },
  {
    icon: ArrowLeftRight,
    tone: "mint",
    title: "Convert",
    description: "Save as JPEG, PNG, WebP, or AVIF.",
  },
  {
    icon: Gauge,
    tone: "lavender",
    title: "Compress",
    description:
      "Set a maximum size; Reshrimp adjusts JPEG, WebP, or AVIF quality and reports when it cannot meet the target.",
  },
  {
    icon: Wand2,
    tone: "yellow",
    title: "Remove a background",
    description: "Make a transparent PNG in your browser.",
  },
] as const;
---

<Section id="tools" title="What you can do.">
  <ul class="grid grid-cols-4 gap-4 hero-compact:grid-cols-2 marketing-mobile:grid-cols-1">
    {
      tools.map((tool) => (
        <Card as="li" class="p-6 marketing-mobile:p-5">
          <IconTile icon={tool.icon} tone={tool.tone} />
          <h3 class="mt-5 font-display text-title-sm text-fg">{tool.title}</h3>
          <p class="mt-2 text-base text-fg-muted text-pretty">{tool.description}</p>
        </Card>
      ))
    }
  </ul>
</Section>
