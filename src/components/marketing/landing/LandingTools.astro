---
import { ArrowLeftRight, Gauge, Scaling, Wand2 } from "lucide-astro";
import FeatureCard from "../cards/FeatureCard.astro";
import Section from "../layout/Section.astro";

const tools = [
  {
    icon: Scaling,
    tone: "coral",
    title: "Resize",
    description: "Set a new width or height. Keep the original ratio when you need to.",
  },
  {
    icon: ArrowLeftRight,
    tone: "mint",
    title: "Convert",
    description: "Save as JPEG, PNG, WebP, or AVIF.",
  },
  {
    icon: Gauge,
    tone: "lavender",
    title: "Compress",
    description:
      "Set a maximum size; Reshrimp adjusts JPEG, WebP, or AVIF quality and reports when it cannot meet the target.",
  },
  {
    icon: Wand2,
    tone: "yellow",
    title: "Remove a background",
    description: "Make a transparent PNG in your browser.",
  },
] as const;
---

<Section id="tools" title="What you can do.">
  <ul class="grid grid-cols-2 gap-4 marketing-mobile:grid-cols-1">
    {
      tools.map((tool) => (
        <FeatureCard icon={tool.icon} tone={tool.tone} title={tool.title}>
          <p>{tool.description}</p>
        </FeatureCard>
      ))
    }
  </ul>
</Section>
