---
import ButtonLink from "../../ui/ButtonLink.astro";
import { makeHref } from "../../../lib/utils";
import { ROUTES } from "../../../config/constants";
---

<section class="landing-final-cta">
  <div class="landing-final-inner" data-reveal>
    <h2>Ready to change an image?</h2>
    <p>Choose an image, make the change you need, and download the result.</p>
    <ButtonLink href={makeHref(ROUTES.APP)} size="lg">
      Choose an image
    </ButtonLink>
  </div>
</section>

<style>
  .landing-final-cta {
    position: relative;
    z-index: 1;
    padding: var(--marketing-section-space) var(--marketing-gutter) var(--space-16);
    text-align: center;
  }

  .landing-final-inner {
    max-width: var(--marketing-narrow-width);
    margin: 0 auto;
  }

  .landing-final-inner h2,
  .landing-final-inner p {
    margin-right: auto;
    margin-left: auto;
  }

  .landing-final-inner h2 {
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: var(--marketing-title-lg);
    line-height: var(--marketing-title-leading);
    letter-spacing: var(--marketing-tight-tracking);
    text-wrap: balance;
  }

  .landing-final-inner p {
    max-width: 26rem;
    margin-top: var(--space-5);
    margin-bottom: var(--space-8);
    color: var(--muted-foreground);
    font-size: var(--marketing-small-size);
    line-height: var(--marketing-body-leading);
  }

  @media (max-width: 560px) {
    .landing-final-inner :global(a[data-ui-button]) {
      width: 100%;
    }
  }
</style>
