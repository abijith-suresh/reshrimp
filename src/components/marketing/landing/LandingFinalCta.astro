---
import ButtonLink from "../../ui/ButtonLink.astro";
import { makeHref } from "../../../lib/utils";
import { ROUTES } from "../../../config/constants";
import MarketingContainer from "../layout/MarketingContainer.astro";
---

<section class="relative z-1 pt-marketing-section px-marketing-gutter pb-16">
  <MarketingContainer>
    <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-[clamp(2rem,6vw,4rem)] text-start marketing-mobile:grid-cols-1 marketing-mobile:gap-8" data-reveal>
      <div>
        <h2 class="max-w-marketing-narrow m-0 text-foreground font-display text-marketing-title-lg leading-none tracking-marketing-tight text-balance">Ready to change an image?</h2>
        <p class="max-w-marketing-narrow mt-4 mb-0 text-muted-foreground text-marketing-small leading-marketing-body">Choose an image, make the change you need, and download the result.</p>
      </div>
      <ButtonLink href={makeHref(ROUTES.APP)} size="lg" class="marketing-mobile:w-full">
        Choose an image
      </ButtonLink>
    </div>
  </MarketingContainer>
</section>
