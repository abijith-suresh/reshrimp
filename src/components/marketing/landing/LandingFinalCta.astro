---
import { ArrowUpRight } from "lucide-astro";
import ButtonLink from "../../ui/ButtonLink.astro";
import { makeHref } from "../../../lib/utils";
import { ROUTES } from "../../../config/constants";
---

<section class="landing-final-cta">
  <div class="landing-final-inner" data-reveal>
    <h2>Ready when you are.</h2>
    <p>Open the tool and get the image you need, without sending it anywhere.</p>
    <ButtonLink href={makeHref(ROUTES.APP)} size="lg">
      Open Reshrimp
      <ArrowUpRight size={19} strokeWidth={2} aria-hidden="true" />
    </ButtonLink>
  </div>
</section>

<style>
  .landing-final-cta {
    position: relative;
    z-index: 1;
    padding: clamp(5.5rem, 11vw, 10rem) 2rem clamp(6rem, 12vw, 11rem);
    text-align: center;
  }

  .landing-final-inner {
    max-width: 38rem;
    margin: 0 auto;
  }

  .landing-final-inner h2,
  .landing-final-inner p {
    margin-right: auto;
    margin-left: auto;
  }

  .landing-final-inner h2 {
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  .landing-final-inner p {
    max-width: 26rem;
    margin-top: 1.25rem;
    margin-bottom: 2rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  @media (max-width: 560px) {
    .landing-final-cta {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .landing-final-inner :global(a[data-ui-button]) {
      width: 100%;
    }
  }
</style>
