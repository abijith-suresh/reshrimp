---
import MarketingSectionHeading from "../sections/MarketingSectionHeading.astro";
import MarketingContainer from "../layout/MarketingContainer.astro";
---

<section class="relative z-1 py-marketing-section px-marketing-gutter scroll-mt-16" id="workflow">
  <MarketingContainer>
    <MarketingSectionHeading title="Upload. Change. Download." />

    <ol class="grid grid-cols-3 gap-8 m-0 p-0 list-none marketing-stack:flex marketing-stack:flex-col marketing-stack:gap-0">
      <li class="relative flex flex-col gap-6 min-h-20 pt-5 border-t border-border marketing-stack:grid marketing-stack:grid-cols-[3rem_minmax(0,1fr)] marketing-stack:gap-4 marketing-stack:min-h-0 marketing-stack:py-5 marketing-stack:not-last:after:absolute marketing-stack:not-last:after:-bottom-2 marketing-stack:not-last:after:left-[1.1rem] marketing-stack:not-last:after:w-px marketing-stack:not-last:after:h-5 marketing-stack:not-last:after:bg-border marketing-stack:not-last:after:content-['']" data-reveal>
        <span class="text-coral-500 font-mono text-marketing-caption tabular-nums">01</span>
        <div>
          <h3 class="m-0 mb-2 text-foreground font-display text-marketing-title-sm tracking-[-0.035em]">Choose an image</h3>
          <p class="max-w-60 m-0 text-muted-foreground text-marketing-small leading-marketing-body marketing-stack:max-w-marketing-narrow">Drop a file in or choose one from your device.</p>
        </div>
      </li>
      <li class="relative flex flex-col gap-6 min-h-20 pt-5 border-t border-border marketing-stack:grid marketing-stack:grid-cols-[3rem_minmax(0,1fr)] marketing-stack:gap-4 marketing-stack:min-h-0 marketing-stack:py-5 marketing-stack:not-last:after:absolute marketing-stack:not-last:after:-bottom-2 marketing-stack:not-last:after:left-[1.1rem] marketing-stack:not-last:after:w-px marketing-stack:not-last:after:h-5 marketing-stack:not-last:after:bg-border marketing-stack:not-last:after:content-['']" data-reveal>
        <span class="text-coral-500 font-mono text-marketing-caption tabular-nums">02</span>
        <div>
          <h3 class="m-0 mb-2 text-foreground font-display text-marketing-title-sm tracking-[-0.035em]">Set the options</h3>
          <p class="max-w-60 m-0 text-muted-foreground text-marketing-small leading-marketing-body marketing-stack:max-w-marketing-narrow">Choose dimensions, a format, and a quality or size target.</p>
        </div>
      </li>
      <li class="relative flex flex-col gap-6 min-h-20 pt-5 border-t border-border marketing-stack:grid marketing-stack:grid-cols-[3rem_minmax(0,1fr)] marketing-stack:gap-4 marketing-stack:min-h-0 marketing-stack:py-5 marketing-stack:not-last:after:absolute marketing-stack:not-last:after:-bottom-2 marketing-stack:not-last:after:left-[1.1rem] marketing-stack:not-last:after:w-px marketing-stack:not-last:after:h-5 marketing-stack:not-last:after:bg-border marketing-stack:not-last:after:content-['']" data-reveal>
        <span class="text-coral-500 font-mono text-marketing-caption tabular-nums">03</span>
        <div>
          <h3 class="m-0 mb-2 text-foreground font-display text-marketing-title-sm tracking-[-0.035em]">Download the result</h3>
          <p class="max-w-60 m-0 text-muted-foreground text-marketing-small leading-marketing-body marketing-stack:max-w-marketing-narrow">Save the file when the preview looks right.</p>
        </div>
      </li>
    </ol>

  </MarketingContainer>
</section>
