---
import { ChevronDown, Download } from "lucide-astro";
import { ROUTES } from "../../../config/constants";
import { makeHref } from "../../../lib/utils";
import ButtonLink from "../../ui/ButtonLink.astro";
import Container from "../layout/Container.astro";

const fieldClass =
  "flex h-8 items-center justify-between gap-1 rounded-sm border border-line bg-surface px-2.5 text-xs font-semibold text-fg";
const labelClass =
  "mt-1 flex items-center justify-between text-xs font-semibold text-fg first:mt-0";
const handleClass = "absolute size-2.5 rounded-xs border-2 border-primary bg-surface";
---

<section class="pt-16 pb-section hero-stack:pt-10" aria-labelledby="hero-title">
  <Container>
    <div class="grid grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] items-center gap-12 hero-compact:gap-10 hero-stack:grid-cols-1">
      <div class="animate-rise hero-stack:max-w-prose">
        <h1 id="hero-title" class="font-display text-display text-fg text-balance">
          Fit your photo<br />
          <span class="text-primary">to the form.</span>
        </h1>
        <p class="mt-6 max-w-md text-lg text-fg-muted text-pretty">
          Set the pixel size, format, and max file size the portal asks for. Your image never
          leaves your device.
        </p>
        <div class="mt-8">
          <ButtonLink href={makeHref(ROUTES.APP)} size="lg" class="marketing-mobile:w-full">
            Open Reshrimp
          </ButtonLink>
        </div>
      </div>

      <figure
        class="relative m-0 min-w-0 animate-rise-late"
        role="img"
        aria-label="Preview of the Reshrimp app saving a photo as a 640 × 480 JPEG under 50 KB"
      >
        <div class="relative" aria-hidden="true">
          <span class="absolute -top-5 -left-5 size-20 rounded-full bg-mint-subtle marketing-mobile:-top-3 marketing-mobile:-left-2 marketing-mobile:size-14"></span>
          <span class="absolute -right-4 -bottom-5 size-24 rotate-12 rounded-xl bg-yellow-subtle marketing-mobile:-right-2 marketing-mobile:size-16"></span>

          <div class="relative overflow-hidden rounded-lg border border-line bg-surface shadow-lg">
            <div class="flex h-12 items-center gap-3 border-b border-line px-4 marketing-mobile:px-3">
              <span class="flex gap-1.5">
                <span class="size-2 rounded-full bg-coral"></span>
                <span class="size-2 rounded-full bg-line-strong"></span>
                <span class="size-2 rounded-full bg-line-strong"></span>
              </span>
              <span class="min-w-0 flex-1 truncate text-xs font-semibold text-fg-muted" translate="no">photo.jpg</span>
              <span class="shrink-0 rounded-full bg-mint-subtle px-2.5 py-1 text-xs font-semibold whitespace-nowrap text-mint-ink">
                1.8 MB → 46 KB
              </span>
            </div>

            <div class="flex">
              <div class="relative flex min-w-0 flex-1 items-center justify-center bg-surface-muted px-10 py-12 marketing-mobile:px-5 marketing-mobile:py-8">
                <div class="absolute inset-0 bg-transparency-grid bg-size-[16px_16px] bg-[position:0_0,0_8px,8px_-8px,-8px_0] text-line opacity-60"></div>
                <div class="relative w-full max-w-72 -rotate-2">
                  <div class="relative aspect-4/3 overflow-hidden rounded-md border-4 border-surface bg-linear-to-b from-coral-subtle to-lavender-subtle shadow-md">
                    <span class="absolute top-1/8 right-1/6 aspect-square w-1/5 rounded-full bg-yellow"></span>
                    <span class="absolute -right-1/4 -bottom-1/3 h-2/3 w-5/6 rounded-t-full bg-lavender"></span>
                    <span class="absolute -bottom-1/3 -left-1/4 h-2/3 w-full rounded-t-full bg-mint"></span>
                    <span class="absolute bottom-1/8 left-1/4 h-2/5 w-1/5 rounded-t-full rounded-b-md bg-coral shadow-md"></span>
                  </div>
                  <span class:list={[handleClass, "-top-1 -left-1"]}></span>
                  <span class:list={[handleClass, "-top-1 -right-1"]}></span>
                  <span class:list={[handleClass, "-bottom-1 -left-1"]}></span>
                  <span class:list={[handleClass, "-right-1 -bottom-1"]}></span>
                </div>
              </div>

              <div class="flex w-48 shrink-0 flex-col gap-2 border-l border-line p-4 marketing-mobile:w-32 marketing-mobile:p-3">
                <span class={labelClass}>Resize</span>
                <span class={fieldClass}>
                  640 <span class="font-normal text-fg-soft">×</span> 480
                </span>
                <span class={labelClass}>Format</span>
                <span class={fieldClass}>
                  JPEG <ChevronDown size={14} class="text-fg-soft" />
                </span>
                <span class={labelClass}>Max file size</span>
                <span class={fieldClass}>
                  50 <span class="font-normal text-fg-soft">KB</span>
                </span>
                <span class="mt-auto flex h-8 items-center justify-center gap-1.5 rounded-sm bg-primary pt-px text-xs font-semibold text-primary-fg shadow-primary">
                  <Download size={14} /> Download
                </span>
              </div>
            </div>
          </div>
        </div>
      </figure>
    </div>
  </Container>
</section>
