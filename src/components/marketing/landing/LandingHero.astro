---
import ButtonLink from "../../ui/ButtonLink.astro";
import { makeHref } from "../../../lib/utils";
import { ROUTES } from "../../../config/constants";
import MarketingContainer from "../layout/MarketingContainer.astro";
---

<section class="relative z-1 pt-marketing-hero px-marketing-gutter pb-marketing-section-compact hero-stack:pt-10 marketing-mobile:pt-8 marketing-mobile:px-4 marketing-mobile:pb-12">
  <MarketingContainer>
    <div class="grid grid-cols-[minmax(0,0.82fr)_minmax(520px,1.18fr)] items-center gap-[clamp(2rem,7vw,5rem)] hero-compact:grid-cols-[minmax(0,0.9fr)_minmax(420px,1.1fr)] hero-compact:gap-8 hero-stack:flex hero-stack:flex-col hero-stack:items-stretch hero-stack:gap-10">
      <div class="relative z-2 animate-landing-copy-in hero-stack:max-w-[40rem]">
        <h1 class="max-w-[620px] m-0 text-foreground font-display text-marketing-title-xl font-bold leading-none tracking-marketing-tight text-balance marketing-mobile:text-marketing-title-mobile">
          Resize an image.<br />
          <span class="text-coral-500">Keep it private.</span>
        </h1>
        <p class="max-w-[35rem] mt-6 mb-0 text-muted-foreground text-marketing-body leading-marketing-body marketing-mobile:mt-5">
          Resize, convert, compress, or remove a background. Your image stays in your browser.
        </p>
        <div class="flex items-center flex-wrap gap-4 mt-6 marketing-mobile:items-stretch marketing-mobile:flex-col marketing-mobile:gap-3 marketing-mobile:mt-5">
          <ButtonLink href={makeHref(ROUTES.APP)} size="lg" class="marketing-mobile:w-full">
            Choose an image
          </ButtonLink>
        </div>
      </div>

      <figure
        class="relative min-w-0 m-0 animate-landing-workbench-in hero-stack:w-full hero-stack:max-w-[40rem] hero-stack:mx-auto marketing-mobile:w-[calc(100%+0.75rem)] marketing-mobile:ms-[-0.375rem]"
        role="img"
        aria-label="Preview of the Reshrimp image workspace with an image preview, resize controls, and output settings"
      >
        <div class="absolute size-56 rounded-full blur-[40px] opacity-60 pointer-events-none -top-10 -right-4 bg-coral-100"></div>
        <div class="absolute size-56 rounded-full blur-[40px] opacity-60 pointer-events-none -bottom-12 left-[8%] bg-lavender-100"></div>
        <div class="relative z-1 overflow-hidden border border-white/90 rounded-xl bg-white/72 shadow-[0_2px_3px_rgba(51,39,76,0.03),0_20px_70px_rgba(51,39,76,0.14)] backdrop-blur-[24px] marketing-mobile:rounded-lg">
          <div class="flex items-center gap-[0.8rem] min-h-14 px-5 border-b border-[rgba(94,78,126,0.1)] text-soft-foreground text-[0.7rem] font-semibold marketing-mobile:min-h-12 marketing-mobile:px-[0.9rem]">
            <div class="flex gap-[0.3rem] [&>span]:size-[0.42rem] [&>span]:rounded-full [&>span]:bg-border [&>span:first-child]:bg-coral-300" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <span class="min-w-0 flex-1 truncate" translate="no">image.webp</span>
          </div>

          <div class="grid grid-cols-[minmax(0,1fr)_11.5rem] min-h-88 marketing-mobile:grid-cols-[minmax(0,1fr)_8.75rem] marketing-mobile:min-h-72">
            <div class="relative flex items-center justify-center overflow-hidden min-w-0 p-[clamp(1.5rem,4vw,3.5rem)] bg-[rgba(248,247,255,0.72)] marketing-mobile:p-4">
              <div class="absolute inset-0 opacity-[0.42] bg-transparency-grid text-border-light bg-[position:0_0,0_8px,8px_-8px,-8px_0] bg-size-[16px_16px]" aria-hidden="true"></div>
              <div class="relative z-1 overflow-hidden w-full max-w-92 aspect-4/3 border-[0.55rem] border-white/78 rounded-[1.2rem] bg-[linear-gradient(145deg,#f8b99d_0%,#ef8f86_42%,#7b739e_100%)] shadow-[0_18px_38px_rgba(54,41,78,0.2)] -rotate-[2.5deg] marketing-mobile:border-[0.35rem]" aria-hidden="true">
                <div class="absolute top-[12%] right-[12%] w-[24%] aspect-square rounded-full bg-[#ffe3a1] shadow-[0_0_2rem_rgba(255,227,161,0.7)]"></div>
                <div class="absolute -right-[12%] -bottom-[25%] -left-[12%] h-[65%] rounded-[50%_50%_0_0] bg-[linear-gradient(155deg,#4c6d68_0%,#273a50_100%)] -rotate-8"></div>
                <div class="absolute bottom-[12%] left-[25%] w-[26%] h-[45%] rounded-[48%_48%_20%_20%] bg-[linear-gradient(180deg,#f6d0ba,#c8676d)] shadow-[0.85rem_0.9rem_0_rgba(33,48,65,0.26)] rotate-8"></div>
              </div>
            </div>

            <div class="flex flex-col gap-[0.65rem] py-[1.35rem] px-[1.1rem] border-l border-[rgba(94,78,126,0.1)] bg-white/55 marketing-mobile:py-[0.9rem] marketing-mobile:px-[0.7rem]" aria-hidden="true">
              <div class="text-foreground text-[0.7rem] font-bold">
                <span>Resize</span>
              </div>
              <div class="flex items-center justify-between min-h-[2.2rem] px-[0.65rem] border border-border-light rounded-[0.6rem] bg-white/76 text-foreground text-[0.72rem] font-semibold gap-[0.35rem] [&>span]:flex-1 [&>b]:text-soft-foreground [&>b]:font-normal">
                <span>1200</span>
                <b>×</b>
                <span>800</span>
              </div>
              <div class="h-px mt-[0.35rem] mb-[0.45rem] bg-border-light"></div>

              <div class="text-foreground text-[0.7rem] font-bold">
                <span>Format</span>
              </div>
              <div class="flex items-center justify-between min-h-[2.2rem] px-[0.65rem] border border-border-light rounded-[0.6rem] bg-white/76 text-foreground text-[0.72rem] font-semibold [&>span]:text-lavender-600 [&>span]:text-marketing-body">WebP <span>⌄</span></div>

              <div class="text-foreground text-[0.7rem] font-bold">
                <span>Quality</span>
              </div>
              <div class="h-[0.3rem] overflow-hidden rounded-full bg-border-light [&>span]:block [&>span]:w-[78%] [&>span]:h-full [&>span]:rounded-[inherit] [&>span]:bg-linear-to-r [&>span]:from-coral-400 [&>span]:to-coral-500"><span></span></div>

            </div>
          </div>
        </div>
      </figure>
    </div>
  </MarketingContainer>
</section>
