---
import { Check, ChevronDown, Download } from "lucide-astro";
import { ROUTES } from "../../../config/constants";
import { makeHref } from "../../../lib/utils";
import ButtonLink from "../../ui/ButtonLink.astro";
import Container from "../layout/Container.astro";

// The demo plays two scenes on one 14s clock: make the photo smaller, then cut
// the bird out. Each element's resting classes show the end of the first
// scene, which is the frame reduced motion keeps. Keyframes live in global.css.
const fieldClass =
  "flex h-8 animate-hero-focus items-center justify-between gap-1 rounded-sm border border-line bg-surface px-2.5 text-xs font-semibold text-fg";
const tickerClass = "h-4 overflow-hidden";
const badgeLayerClass = "col-start-1 row-start-1 flex items-center justify-center gap-1";
const resultSizes = ["96 KB", "74 KB", "63 KB", "54 KB", "46 KB"];
const labelClass =
  "mt-1 flex items-center justify-between text-xs font-semibold text-fg first:mt-0";
const handleClass = "absolute size-2.5 rounded-xs border-2 border-primary bg-surface";
---

<section class="pt-16 pb-section hero-stack:pt-10" aria-labelledby="hero-title">
  <Container>
    <div class="grid grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] items-center gap-12 hero-compact:gap-10 hero-stack:grid-cols-1">
      <div class="animate-rise hero-stack:max-w-prose">
        <h1 id="hero-title" class="font-display text-display text-fg text-balance">
          Resize images<br />
          <span class="text-primary">privately.</span>
        </h1>
        <p class="mt-6 max-w-md text-lg text-fg-muted text-pretty">
          Compress, convert, and remove backgrounds too. It all happens in your browser, so
          there's no upload to wait for.
        </p>
        <div class="mt-8">
          <ButtonLink href={makeHref(ROUTES.APP)} size="lg" class="marketing-mobile:w-full">
            Open Reshrimp
          </ButtonLink>
        </div>
      </div>

      <figure
        class="relative m-0 min-w-0 animate-rise-late data-paused:**:[animation-play-state:paused]"
        role="img"
        aria-label="Preview of the Reshrimp app shrinking a 1.8 MB photo to a 46 KB WebP, then cutting the bird out of it as a transparent PNG"
        data-hero-demo
      >
        <div class="relative" aria-hidden="true">
          <span class="absolute -top-5 -left-5 size-20 rounded-full bg-mint-subtle marketing-mobile:-top-3 marketing-mobile:-left-2 marketing-mobile:size-14"></span>
          <span class="absolute -right-4 -bottom-5 size-24 rotate-12 rounded-xl bg-yellow-subtle marketing-mobile:-right-2 marketing-mobile:size-16"></span>

          <div class="relative overflow-hidden rounded-lg border border-line bg-surface shadow-lg">
            <div class="flex h-12 items-center gap-3 border-b border-line px-4 marketing-mobile:px-3">
              <span class="flex gap-1.5">
                <span class="size-2 rounded-full bg-coral"></span>
                <span class="size-2 rounded-full bg-line-strong"></span>
                <span class="size-2 rounded-full bg-line-strong"></span>
              </span>
              <span class="min-w-0 flex-1 truncate text-xs font-semibold text-fg-muted" translate="no">photo.jpg</span>
              <span class="grid shrink-0 rounded-full bg-mint-subtle px-2.5 py-1 text-xs font-semibold whitespace-nowrap text-mint-ink tabular-nums">
                <span class:list={[badgeLayerClass, "animate-hero-badge-original opacity-0"]}>1.8 MB</span>
                <span class:list={[badgeLayerClass, "animate-hero-badge-result"]}>
                  1.8 MB →
                  <span class={tickerClass}>
                    <span class="flex -translate-y-16 animate-hero-badge-size flex-col items-end">
                      {resultSizes.map((size) => <span class="h-4">{size}</span>)}
                    </span>
                  </span>
                </span>
                <span class:list={[badgeLayerClass, "animate-hero-badge-cutout opacity-0"]}>Transparent PNG</span>
              </span>
            </div>

            <div class="flex">
              <div class="relative flex min-w-0 flex-1 items-center justify-center bg-surface-muted px-10 py-12 marketing-mobile:px-5 marketing-mobile:py-8">
                <div class="absolute inset-0 bg-transparency-grid bg-size-[16px_16px] bg-[position:0_0,0_8px,8px_-8px,-8px_0] text-line opacity-60"></div>
                <div class="relative w-full max-w-72 -rotate-2 animate-hero-picture">
                  <div class="relative aspect-4/3">
                    <div class="absolute inset-0 animate-hero-backdrop overflow-hidden rounded-md border-4 border-surface bg-linear-to-b from-lavender-subtle to-coral-subtle shadow-md">
                      <svg viewBox="0 0 160 120" class="absolute inset-0 size-full">
                        <circle cx="126" cy="28" r="13" class="fill-yellow" />
                        <path d="M22 34a9 9 0 0 1 16-6 11 11 0 0 1 20 4 7 7 0 0 1 0 14H26a6 6 0 0 1-4-12z" class="fill-surface" />
                        <ellipse cx="148" cy="122" rx="84" ry="42" class="fill-lavender" />
                        <ellipse cx="44" cy="128" rx="108" ry="34" class="fill-mint" />
                      </svg>
                    </div>
                    <svg viewBox="0 0 160 120" class="absolute inset-0 size-full">
                      <path d="M86 92l-2 8M96 92v8" class="fill-none stroke-yellow-ink" stroke-width="2.5" stroke-linecap="round" />
                      <path d="M70 70L42 58l6 18z" class="fill-fg" />
                      <ellipse cx="88" cy="74" rx="24" ry="19" class="fill-fg" />
                      <path d="M104 64a14 14 0 0 1-2 26 18 18 0 0 1-14-14 14 14 0 0 1 16-12z" class="fill-coral" />
                      <circle cx="104" cy="54" r="13" class="fill-fg" />
                      <path d="M115 50l11 5-11 5z" class="fill-yellow" />
                      <ellipse cx="80" cy="70" rx="15" ry="9" transform="rotate(-14 80 70)" class="fill-fg-muted" />
                      <circle cx="108" cy="51" r="3.5" class="fill-surface" />
                      <circle cx="109" cy="51" r="1.8" class="fill-fg" />
                    </svg>
                  </div>
                  <span class:list={[handleClass, "-top-1 -left-1"]}></span>
                  <span class:list={[handleClass, "-top-1 -right-1"]}></span>
                  <span class:list={[handleClass, "-bottom-1 -left-1"]}></span>
                  <span class:list={[handleClass, "-right-1 -bottom-1"]}></span>
                </div>
              </div>

              <div class="flex w-48 shrink-0 flex-col gap-2 border-l border-line p-4 marketing-mobile:w-32 marketing-mobile:p-3">
                <span class={labelClass}>Resize</span>
                <span class:list={[fieldClass, "[animation-delay:0.2s]"]}>
                  <span class={tickerClass}>
                    <span class="flex -translate-y-4 animate-hero-resize flex-col">
                      <span class="h-4">4032 <span class="font-normal text-fg-soft">×</span> 3024</span>
                      <span class="h-4">640 <span class="font-normal text-fg-soft">×</span> 480</span>
                    </span>
                  </span>
                </span>
                <span class={labelClass}>Format</span>
                <span class="flex animate-hero-disabled flex-col">
                  <span class:list={[fieldClass, "[animation-delay:2.2s]"]}>
                    <span class={tickerClass}>
                      <span class="flex animate-hero-format flex-col">
                        <span class="h-4">WebP</span>
                        <span class="h-4">JPEG</span>
                        <span class="h-4">PNG</span>
                      </span>
                    </span>
                    <ChevronDown size={14} class="text-fg-soft" />
                  </span>
                </span>
                <span class={labelClass}>Max file size</span>
                <span class="flex animate-hero-disabled flex-col">
                  <span class:list={[fieldClass, "[animation-delay:3.8s]"]}>
                    <span class={tickerClass}>
                      <span class="flex -translate-y-4 animate-hero-size flex-col">
                        <span class="h-4 font-normal text-fg-soft">e.g. 500</span>
                        <span class="h-4">50 <span class="font-normal text-fg-soft">KB</span></span>
                      </span>
                    </span>
                  </span>
                </span>
                <span class="mt-1 flex items-center gap-2 text-xs font-semibold text-fg">
                  <span class="relative size-4 shrink-0 animate-hero-checkbox rounded-xs border border-fg-soft bg-surface">
                    <Check size={12} stroke-width={3} class="absolute inset-0 m-auto animate-hero-check text-primary-fg opacity-0" />
                  </span>
                  Remove bg
                </span>
                <span class="mt-auto flex h-8 items-center justify-center gap-1.5 rounded-sm bg-primary pt-px text-xs font-semibold text-primary-fg shadow-primary">
                  <Download size={14} /> Download
                </span>
              </div>
            </div>
          </div>
        </div>
      </figure>
    </div>
  </Container>
</section>

<script>
  import { registerPageInitializer } from "../../../lib/pageInitializer";

  // Pause the hero demo while it is off screen.
  registerPageInitializer("landing-hero:demo", () => {
    const demo = document.querySelector<HTMLElement>("[data-hero-demo]");
    if (!demo) return;

    const observer = new IntersectionObserver(([entry]) => {
      demo.toggleAttribute("data-paused", !entry?.isIntersecting);
    });
    observer.observe(demo);

    return () => observer.disconnect();
  });
</script>
