---
import { ArrowDown, ArrowUpRight } from "lucide-astro";
import ButtonLink from "../../ui/ButtonLink.astro";
import { makeHref } from "../../../lib/utils";
import { ROUTES } from "../../../config/constants";
---

<section class="landing-hero">
  <div class="landing-hero-inner">
    <div class="landing-hero-copy">
      <h1>
        Image work,<br />
        <span>without the upload.</span>
      </h1>
      <p class="landing-hero-description">
        Resize, convert, compress, or remove a background in your browser. Your image stays on your
        device.
      </p>
      <div class="landing-hero-actions">
        <ButtonLink href={makeHref(ROUTES.APP)} size="lg">
          Open the image tool
          <ArrowUpRight size={19} strokeWidth={2} aria-hidden="true" />
        </ButtonLink>
        <a class="landing-text-link" href="#workflow">
          See how it works
          <ArrowDown size={16} strokeWidth={2} aria-hidden="true" />
        </a>
      </div>
      <p class="landing-hero-proof">
        <span><i aria-hidden="true"></i>Free to use</span>
        <span><i aria-hidden="true"></i>No account</span>
        <span><i aria-hidden="true"></i>Runs locally</span>
      </p>
    </div>

    <figure
      class="landing-workbench"
      role="img"
      aria-label="Preview of the Reshrimp image workspace with an image preview, resize controls, and an apply button"
    >
      <div class="workbench-glow workbench-glow-coral"></div>
      <div class="workbench-glow workbench-glow-lavender"></div>
      <div class="workbench-window">
        <div class="workbench-toolbar">
          <div class="workbench-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="workbench-file">reshrimp / image.webp</span>
          <span class="workbench-status"><i aria-hidden="true"></i>Ready</span>
        </div>

        <div class="workbench-body">
          <div class="workbench-stage">
            <div class="stage-grid" aria-hidden="true"></div>
            <div class="stage-image" aria-hidden="true">
              <div class="stage-sun"></div>
              <div class="stage-landscape"></div>
              <div class="stage-subject"></div>
            </div>
            <span class="stage-label">Preview</span>
          </div>

          <div class="workbench-controls" aria-hidden="true">
            <div class="workbench-control-heading">
              <span>Resize</span>
              <span class="control-muted">PX</span>
            </div>
            <div class="control-inputs">
              <span>1200</span>
              <b>×</b>
              <span>800</span>
            </div>
            <div class="control-line"></div>

            <div class="workbench-control-heading">
              <span>Format</span>
              <span class="control-muted">OUTPUT</span>
            </div>
            <div class="control-select">WebP <span>⌄</span></div>

            <div class="workbench-control-heading quality-heading">
              <span>Quality</span>
              <span class="control-muted">92%</span>
            </div>
            <div class="control-slider"><span></span></div>

            <div class="control-apply">Apply changes <ArrowUpRight size={14} aria-hidden="true" /></div>
          </div>
        </div>
      </div>
      <span class="workbench-caption">A focused workspace for one image.</span>
    </figure>
  </div>
</section>

<style>
  .landing-hero {
    position: relative;
    z-index: 1;
    padding: clamp(4.75rem, 9vw, 8.5rem) 2rem clamp(5rem, 9vw, 8rem);
  }

  .landing-hero-inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(520px, 1.18fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .landing-hero-copy {
    position: relative;
    z-index: 2;
    animation: landing-copy-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .landing-hero h1 {
    max-width: 620px;
    margin: 0;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 6.4vw, 6.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  .landing-hero h1 span {
    background: linear-gradient(115deg, var(--coral-500), var(--lavender-600));
    background-clip: text;
    color: transparent;
  }

  .landing-hero-description {
    max-width: 440px;
    margin: 2rem 0 0;
    color: var(--muted-foreground);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.65;
  }

  .landing-hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2.25rem;
  }

  .landing-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--foreground);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .landing-text-link:hover {
    color: var(--coral-600);
  }

  .landing-text-link:focus-visible {
    outline: 2px solid var(--lavender-500);
    outline-offset: 5px;
    border-radius: 4px;
  }

  .landing-hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.15rem;
    margin: 2.25rem 0 0;
    color: var(--soft-foreground);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .landing-hero-proof span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .landing-hero-proof i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--mint-500);
  }

  .landing-workbench {
    position: relative;
    min-width: 0;
    margin: 0;
    animation: landing-workbench-in 800ms 120ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .workbench-glow {
    position: absolute;
    width: 14rem;
    height: 14rem;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.6;
    pointer-events: none;
  }

  .workbench-glow-coral {
    top: -2.5rem;
    right: -1rem;
    background: var(--coral-100);
  }

  .workbench-glow-lavender {
    bottom: -3rem;
    left: 8%;
    background: var(--lavender-100);
  }

  .workbench-window {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 1.75rem;
    background: rgba(255, 255, 255, 0.72);
    box-shadow:
      0 2px 3px rgba(51, 39, 76, 0.03),
      0 20px 70px rgba(51, 39, 76, 0.14);
    backdrop-filter: blur(24px);
  }

  .workbench-toolbar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 3.5rem;
    padding: 0 1.25rem;
    border-bottom: 1px solid rgba(94, 78, 126, 0.1);
    color: var(--soft-foreground);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .workbench-dots {
    display: flex;
    gap: 0.3rem;
  }

  .workbench-dots span {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--border);
  }

  .workbench-dots span:first-child {
    background: var(--coral-300);
  }

  .workbench-file {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .workbench-status {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    color: var(--mint-700);
  }

  .workbench-status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--mint-500);
    box-shadow: 0 0 0 4px var(--mint-50);
  }

  .workbench-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11.5rem;
    min-height: 25rem;
  }

  .workbench-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background: rgba(248, 247, 255, 0.72);
  }

  .stage-grid {
    position: absolute;
    inset: 0;
    opacity: 0.42;
    background-image:
      linear-gradient(45deg, var(--border-light) 25%, transparent 25%),
      linear-gradient(-45deg, var(--border-light) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--border-light) 75%),
      linear-gradient(-45deg, transparent 75%, var(--border-light) 75%);
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-size: 16px 16px;
  }

  .stage-image {
    position: relative;
    z-index: 1;
    overflow: hidden;
    width: min(100%, 23rem);
    aspect-ratio: 4 / 3;
    border: 0.55rem solid rgba(255, 255, 255, 0.78);
    border-radius: 1.2rem;
    background: linear-gradient(145deg, #f8b99d 0%, #ef8f86 42%, #7b739e 100%);
    box-shadow: 0 18px 38px rgba(54, 41, 78, 0.2);
    transform: rotate(-2.5deg);
  }

  .stage-sun {
    position: absolute;
    top: 12%;
    right: 12%;
    width: 24%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffe3a1;
    box-shadow: 0 0 2rem rgba(255, 227, 161, 0.7);
  }

  .stage-landscape {
    position: absolute;
    right: -12%;
    bottom: -25%;
    left: -12%;
    height: 65%;
    border-radius: 50% 50% 0 0;
    background: linear-gradient(155deg, #4c6d68 0%, #273a50 100%);
    transform: rotate(-8deg);
  }

  .stage-subject {
    position: absolute;
    bottom: 12%;
    left: 25%;
    width: 26%;
    height: 45%;
    border-radius: 48% 48% 20% 20%;
    background: linear-gradient(180deg, #f6d0ba, #c8676d);
    box-shadow: 0.85rem 0.9rem 0 rgba(33, 48, 65, 0.26);
    transform: rotate(8deg);
  }

  .stage-label {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    padding: 0.4rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.7);
    color: var(--muted-foreground);
    font-size: 0.65rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }

  .workbench-controls {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.35rem 1.1rem;
    border-left: 1px solid rgba(94, 78, 126, 0.1);
    background: rgba(255, 255, 255, 0.55);
  }

  .workbench-control-heading {
    display: flex;
    justify-content: space-between;
    color: var(--foreground);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .control-muted {
    color: var(--soft-foreground);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
  }

  .control-inputs,
  .control-select {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.2rem;
    padding: 0 0.65rem;
    border: 1px solid var(--border-light);
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.76);
    color: var(--foreground);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .control-inputs {
    gap: 0.35rem;
  }

  .control-inputs span {
    flex: 1;
  }

  .control-inputs b {
    color: var(--soft-foreground);
    font-weight: 400;
  }

  .control-select span {
    color: var(--lavender-600);
    font-size: 1rem;
  }

  .control-line {
    height: 1px;
    margin: 0.35rem 0 0.45rem;
    background: var(--border-light);
  }

  .quality-heading {
    margin-top: 0.45rem;
  }

  .control-slider {
    height: 0.3rem;
    overflow: hidden;
    border-radius: var(--radius-full);
    background: var(--border-light);
  }

  .control-slider span {
    display: block;
    width: 78%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--coral-400), var(--coral-500));
  }

  .control-apply {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.35rem;
    margin-top: auto;
    border-radius: 0.65rem;
    background: var(--coral-500);
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    box-shadow: var(--shadow-coral);
  }

  .workbench-caption {
    display: block;
    margin-top: 1rem;
    color: var(--soft-foreground);
    font-size: 0.72rem;
    text-align: right;
  }

  @keyframes landing-copy-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes landing-workbench-in {
    from {
      opacity: 0;
      transform: translateY(1.75rem) rotate(1.5deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(0);
    }
  }

  @media (max-width: 1024px) {
    .landing-hero-inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
      gap: 3rem;
    }

    .landing-hero h1 {
      font-size: clamp(3rem, 6.5vw, 4.8rem);
    }
  }

  @media (max-width: 820px) {
    .landing-hero {
      padding-top: 4.5rem;
    }

    .landing-hero-inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 3.5rem;
    }

    .landing-hero-copy {
      max-width: 40rem;
    }

    .landing-workbench {
      width: min(100%, 40rem);
      margin: 0 auto;
    }
  }

  @media (max-width: 560px) {
    .landing-hero {
      padding: 3.5rem 1rem 4.5rem;
    }

    .landing-hero h1 {
      font-size: clamp(3rem, 15vw, 4.2rem);
      letter-spacing: -0.07em;
    }

    .landing-hero-description {
      margin-top: 1.5rem;
    }

    .landing-hero-actions {
      align-items: stretch;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.75rem;
    }

    .landing-hero-actions :global(a[data-ui-button]) {
      width: 100%;
    }

    .landing-text-link {
      align-self: center;
    }

    .landing-hero-proof {
      gap: 0.65rem 0.9rem;
      margin-top: 1.75rem;
    }

    .landing-workbench {
      width: calc(100% + 0.75rem);
      margin-left: -0.375rem;
    }

    .workbench-window {
      border-radius: 1.25rem;
    }

    .workbench-toolbar {
      min-height: 3rem;
      padding: 0 0.9rem;
    }

    .workbench-body {
      grid-template-columns: minmax(0, 1fr) 8.75rem;
      min-height: 19rem;
    }

    .workbench-stage {
      padding: 1rem;
    }

    .stage-image {
      border-width: 0.35rem;
    }

    .workbench-controls {
      padding: 0.9rem 0.7rem;
    }

    .workbench-caption {
      padding-right: 0.25rem;
    }
  }
</style>
