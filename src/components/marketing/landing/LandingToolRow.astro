---
type IconComponent = (
  props: astroHTML.JSX.SVGAttributes & { size?: number; strokeWidth?: number }
) => unknown;

interface Props {
  icon: IconComponent;
  number: string;
  title: string;
  description: string;
  color: "coral" | "mint" | "lavender" | "yellow";
}

const { icon: Icon, number, title, description, color } = Astro.props;
---

<article class:list={["landing-tool-row", `landing-tool-${color}`]} data-reveal>
  <span class="landing-tool-number">{number}</span>
  <span class="landing-tool-icon">
    <Icon size={25} strokeWidth={1.7} aria-hidden="true" />
  </span>
  <div class="landing-tool-copy">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</article>

<style>
  .landing-tool-row {
    --tool-color: var(--coral-500);
    --tool-tint: var(--coral-50);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.25rem var(--space-12) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-3);
    border-top: 1px solid var(--border);
  }

  .landing-tool-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .landing-tool-row:hover {
    background: var(--tool-tint);
    border-color: var(--border);
  }

  .landing-tool-mint {
    --tool-color: var(--mint-600);
    --tool-tint: var(--mint-50);
  }

  .landing-tool-lavender {
    --tool-color: var(--lavender-600);
    --tool-tint: var(--lavender-50);
  }

  .landing-tool-yellow {
    --tool-color: var(--yellow-700);
    --tool-tint: var(--yellow-50);
  }

  .landing-tool-number {
    color: var(--soft-foreground);
    font-family: var(--font-mono);
    font-size: var(--marketing-caption-size);
    font-variant-numeric: tabular-nums;
  }

  .landing-tool-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-12);
    height: var(--space-12);
    border-radius: var(--radius-lg);
    background: var(--tool-tint);
    color: var(--tool-color);
  }

  .landing-tool-copy h3 {
    margin: 0 0 var(--space-1);
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: var(--marketing-title-sm);
    letter-spacing: -0.035em;
  }

  .landing-tool-copy p {
    max-width: 40rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--marketing-small-size);
    line-height: var(--marketing-body-leading);
  }

  @media (max-width: 560px) {
    .landing-tool-row {
      grid-template-columns: 1.75rem var(--space-12) minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-5) var(--space-1);
    }

    .landing-tool-icon {
      width: var(--space-12);
      height: var(--space-12);
      border-radius: var(--radius-md);
    }

  }
</style>
