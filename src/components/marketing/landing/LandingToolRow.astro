---
type IconComponent = (
  props: astroHTML.JSX.SVGAttributes & { size?: number; strokeWidth?: number }
) => unknown;

interface Props {
  icon: IconComponent;
  number: string;
  title: string;
  description: string;
  color: "coral" | "mint" | "lavender" | "yellow";
}

const { icon: Icon, number, title, description, color } = Astro.props;
const iconColors = {
  coral: "bg-coral-50 text-coral-500",
  mint: "bg-mint-50 text-mint-600",
  lavender: "bg-lavender-50 text-lavender-600",
  yellow: "bg-yellow-50 text-yellow-700",
};
---

<article class="grid grid-cols-[2.25rem_3rem_minmax(0,1fr)] items-center gap-6 py-8 px-3 border-t border-border last:border-b marketing-mobile:grid-cols-[1.75rem_3rem_minmax(0,1fr)] marketing-mobile:gap-4 marketing-mobile:py-6 marketing-mobile:px-1" data-reveal>
  <span class="text-soft-foreground font-mono text-marketing-caption tabular-nums">{number}</span>
  <span class:list={["inline-flex items-center justify-center size-12 rounded-lg marketing-mobile:rounded-md", iconColors[color]]}>
    <Icon size={25} strokeWidth={1.7} aria-hidden="true" />
  </span>
  <div class="min-w-0">
    <h3 class="m-0 mb-1 text-foreground font-display text-marketing-title-sm tracking-[-0.035em]">{title}</h3>
    <p class="max-w-[40rem] m-0 text-muted-foreground text-marketing-small leading-marketing-body">{description}</p>
  </div>
</article>
