---
import { ShieldCheck } from "lucide-astro";
import MarketingContainer from "../layout/MarketingContainer.astro";
---

<section class="relative z-1 py-8 px-marketing-gutter marketing-stack:py-6 marketing-stack:px-4" data-reveal>
  <MarketingContainer>
    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-5 py-6 border-y border-border marketing-stack:gap-4 marketing-stack:py-5">
      <div class="flex items-center justify-center size-12 rounded-lg bg-mint-50 text-mint-700 marketing-stack:size-10 marketing-stack:rounded-md">
        <ShieldCheck size={31} strokeWidth={1.6} aria-hidden="true" />
      </div>
      <div class="grid grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] items-center gap-8 marketing-stack:block">
        <h2 class="m-0 text-foreground font-display text-marketing-title-md tracking-[-0.045em]">Your image stays in your browser.</h2>
        <p class="m-0 text-muted-foreground text-marketing-small marketing-stack:mt-2">Reshrimp does not upload images, require an account, or track you.</p>
      </div>
    </div>
  </MarketingContainer>
</section>
