---
import { ShieldCheck } from "lucide-astro";
import MarketingContainer from "../layout/MarketingContainer.astro";
---

<section class="landing-privacy" data-reveal>
  <MarketingContainer>
    <div class="landing-privacy-inner">
      <div class="landing-privacy-icon">
        <ShieldCheck size={31} strokeWidth={1.6} aria-hidden="true" />
      </div>
      <div class="landing-privacy-copy">
        <h2>Your image stays in your browser.</h2>
        <p>Reshrimp does not upload images, require an account, or track you.</p>
      </div>
    </div>
  </MarketingContainer>
</section>

<style>
  .landing-privacy {
    position: relative;
    z-index: 1;
    padding: var(--space-8) var(--marketing-gutter);
  }

  .landing-privacy-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .landing-privacy-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-12);
    height: var(--space-12);
    border-radius: var(--radius-lg);
    background: var(--mint-50);
    color: var(--mint-700);
  }

  .landing-privacy-copy h2,
  .landing-privacy-copy p {
    margin: 0;
  }

  .landing-privacy-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--space-8);
  }

  .landing-privacy-copy h2 {
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: var(--marketing-title-md);
    letter-spacing: -0.045em;
  }

  .landing-privacy-copy p {
    color: var(--muted-foreground);
    font-size: var(--marketing-small-size);
  }

  @media (max-width: 680px) {
    .landing-privacy {
      padding: var(--space-6) var(--space-4);
    }

    .landing-privacy-inner {
      gap: var(--space-4);
      padding-block: var(--space-5);
    }

    .landing-privacy-copy {
      display: block;
    }

    .landing-privacy-copy p {
      margin-top: var(--space-2);
    }

    .landing-privacy-icon {
      width: var(--space-10);
      height: var(--space-10);
      border-radius: var(--radius-md);
    }
  }
</style>
