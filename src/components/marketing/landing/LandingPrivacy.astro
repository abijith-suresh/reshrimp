---
import { ShieldCheck } from "lucide-astro";
import Card from "../cards/Card.astro";
import IconTile from "../cards/IconTile.astro";
import Section from "../layout/Section.astro";
---

<Section>
  <Card class="flex items-center gap-5 p-6 marketing-mobile:flex-col marketing-mobile:items-start marketing-mobile:gap-4 marketing-mobile:p-5">
    <IconTile icon={ShieldCheck} tone="mint" />
    <div class="grid min-w-0 flex-1 grid-cols-2 items-center gap-x-8 gap-y-1 hero-stack:grid-cols-1">
      <h2 class="font-display text-title-sm text-fg text-balance">Your image stays in your browser.</h2>
      <p class="text-base text-fg-muted text-pretty">
        Reshrimp does not upload images, require an account, or track you.
      </p>
    </div>
  </Card>
</Section>
