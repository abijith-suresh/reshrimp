---
// One row of a card: an optional number marker, a title, and the body.
// Rows sit in a Card with `divide-y divide-line`.
interface Props {
  title: string;
  marker?: string;
  as?: "li" | "section";
  level?: 2 | 3;
}

const { title, marker, as: Tag = "li", level = 3 } = Astro.props;
const Heading = level === 2 ? "h2" : "h3";
---

<Tag
  class:list={[
    "grid items-start gap-x-6 gap-y-2 p-6 marketing-menu:p-5",
    marker
      ? "grid-cols-[2.5rem_minmax(0,1fr)_minmax(0,1.6fr)] marketing-menu:grid-cols-[2.5rem_minmax(0,1fr)] marketing-menu:gap-x-4"
      : "grid-cols-[minmax(0,1fr)_minmax(0,2fr)] marketing-menu:grid-cols-1",
  ]}
>
  {
    marker && (
      <span
        aria-hidden="true"
        class="grid size-10 place-items-center rounded-full border border-line font-mono text-sm text-primary tabular-nums"
      >
        {marker}
      </span>
    )
  }
  <Heading class="pt-1.5 font-display text-title-sm text-fg text-balance marketing-menu:pt-0 marketing-menu:self-center">
    {title}
  </Heading>
  <div
    class:list={[
      "pt-2 text-base text-fg-muted text-pretty marketing-menu:pt-0 [&>*+*]:mt-3",
      marker && "marketing-menu:col-start-2",
    ]}
  >
    <slot />
  </div>
</Tag>
