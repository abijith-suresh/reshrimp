---
// The closing card above the footer: a title, one line, and the actions.
import Section from "../layout/Section.astro";
import Card from "./Card.astro";

interface Props {
  title: string;
  copy: string;
}

const { title, copy } = Astro.props;
---

<Section>
  <Card
    class="flex flex-wrap items-center justify-between gap-x-12 gap-y-6 p-8 marketing-mobile:p-6"
  >
    <div class="min-w-0 max-w-prose">
      <h2 class="font-display text-title-md text-fg text-balance">{title}</h2>
      <p class="mt-2 text-base text-fg-muted text-pretty">{copy}</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 marketing-mobile:w-full marketing-mobile:flex-col marketing-mobile:items-stretch">
      <slot />
    </div>
  </Card>
</Section>
