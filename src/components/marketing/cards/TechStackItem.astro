---
interface Props {
  name: string;
  description: string;
}
const { name, description } = Astro.props;
---

<div class="flex flex-col gap-1 py-3 border-t border-border">
  <span class="text-foreground font-display text-marketing-small font-semibold">{name}</span>
  <span class="text-soft-foreground text-marketing-caption">{description}</span>
</div>
