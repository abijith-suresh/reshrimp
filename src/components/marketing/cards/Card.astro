---
// A white Cards surface on the canvas: hairline line, quiet shadow.
interface Props {
  as?: "div" | "section" | "article" | "li" | "ol" | "ul";
  class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["rounded-lg border border-line bg-surface shadow-xs", className]}>
  <slot />
</Tag>
