---
type IconComponent = (
  props: astroHTML.JSX.SVGAttributes & { size?: number; strokeWidth?: number }
) => unknown;

interface Props {
  icon: IconComponent;
  tone: "coral" | "mint" | "lavender" | "yellow";
}

const { icon: Icon, tone } = Astro.props;
const tones = {
  coral: "bg-coral-subtle text-coral-ink",
  mint: "bg-mint-subtle text-mint-ink",
  lavender: "bg-lavender-subtle text-lavender-ink",
  yellow: "bg-yellow-subtle text-yellow-ink",
};
---

<span
  aria-hidden="true"
  class:list={["inline-flex size-11 shrink-0 items-center justify-center rounded-md", tones[tone]]}
>
  <Icon size={22} strokeWidth={1.75} aria-hidden="true" />
</span>
