---
type IconComponent = (
  props: astroHTML.JSX.SVGAttributes & { size?: number; strokeWidth?: number }
) => unknown;

interface Props {
  icon: IconComponent;
  title: string;
  description: string;
  color: "coral" | "mint" | "lavender" | "yellow";
  index: number;
}

const { icon: Icon, title, description, color, index } = Astro.props;
const colorStyles: Record<string, string> = {
  coral: "--feature-color: var(--coral-600); --feature-tint: var(--coral-50);",
  mint: "--feature-color: var(--mint-600); --feature-tint: var(--mint-50);",
  lavender: "--feature-color: var(--lavender-600); --feature-tint: var(--lavender-50);",
  yellow: "--feature-color: var(--yellow-700); --feature-tint: var(--yellow-50);",
};
---

<article
  class="marketing-feature-row"
  style={colorStyles[color]}
  data-reveal
  data-reveal-delay={String(index * 80)}
>
  <span class="marketing-feature-number">{String(index + 1).padStart(2, "0")}</span>
  <span class="marketing-feature-icon">
    <Icon size={27} strokeWidth={1.7} aria-hidden="true" />
  </span>
  <div class="marketing-feature-copy">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
</article>

<style>
  .marketing-feature-row {
    display: grid;
    grid-template-columns: 2.5rem 4rem minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0.75rem;
    border-top: 1px solid var(--border);
  }

  .marketing-feature-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .marketing-feature-number {
    color: var(--soft-foreground);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .marketing-feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 1.15rem;
    background: var(--feature-tint);
    color: var(--feature-color);
  }

  .marketing-feature-copy h2 {
    margin: 0 0 0.35rem;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    letter-spacing: -0.035em;
  }

  .marketing-feature-copy p {
    max-width: 42rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  @media (max-width: 560px) {
    .marketing-feature-row {
      grid-template-columns: 1.75rem 3rem minmax(0, 1fr);
      gap: 0.9rem;
      padding: 1.25rem 0.25rem;
    }

    .marketing-feature-icon {
      width: 3rem;
      height: 3rem;
      border-radius: 1rem;
    }

    .marketing-feature-copy p {
      font-size: 0.82rem;
    }
  }
</style>
