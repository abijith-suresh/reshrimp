---
interface Props {
  question: string;
  answer: string;
  delay?: number;
}

const { question, answer, delay = 0 } = Astro.props;
const answerId = `faq-answer-${question
  .toLowerCase()
  .replace(/\s+/g, "-")
  .replace(/[^a-z0-9-]/g, "")}`;
---

<div class="faq-item" data-reveal data-reveal-delay={String(delay)}>
  <button
    type="button"
    class="faq-question"
    aria-expanded="false"
    aria-controls={answerId}
  >
    {question}
  </button>
  <div class="faq-body" role="region" id={answerId}>
    <div class="overflow-hidden">
      <p
        class="faq-answer"
        set:html={answer}
      />
    </div>
  </div>
</div>

<style>
  .faq-item {
    border-top: 1px solid var(--border);
  }

  .faq-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
    padding: 1.4rem 0;
    border: 0;
    background: transparent;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: left;
    touch-action: manipulation;
    transition: color var(--duration-fast) ease;
    cursor: pointer;
  }

  .faq-question:hover {
    color: var(--coral-600);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--lavender-500);
    outline-offset: -2px;
    border-radius: 0.35rem;
  }

  .faq-question::after {
    content: "+";
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--coral-500);
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-pop);
  }

  .faq-item.faq-open .faq-question::after {
    transform: rotate(45deg);
  }

  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-normal) cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-body {
      transition: none;
    }
  }

  .faq-item.faq-open .faq-body {
    grid-template-rows: 1fr;
  }

  .faq-answer {
    opacity: 0;
    max-width: 44rem;
    padding: 0 0 1.4rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.92rem;
    line-height: 1.7;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    transition-delay: 80ms;
  }

  .faq-item.faq-open .faq-answer {
    opacity: 1;
    transform: translateY(0);
  }

  .faq-answer a {
    color: var(--coral-500);
    text-decoration: underline;
    text-decoration-color: rgba(242, 90, 90, 0.3);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s;
  }

  .faq-answer a:hover {
    text-decoration-color: var(--coral-500);
  }
</style>

<script>
  // Use event delegation so all FAQ items work regardless of how many component instances exist
  function handleFaqClick(e: Event) {
    const question = (e.target as HTMLElement).closest(".faq-question");
    if (!question) return;
    const item = question.closest(".faq-item");
    if (!item) return;
    const isOpen = item.classList.toggle("faq-open");
    question.setAttribute("aria-expanded", String(isOpen));
  }

  document.addEventListener("click", handleFaqClick);
</script>
