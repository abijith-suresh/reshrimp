---
interface Props {
  question: string;
  answer: string;
  delay?: number;
}

const { question, answer, delay = 0 } = Astro.props;
const answerId = `faq-answer-${question
  .toLowerCase()
  .replace(/\s+/g, "-")
  .replace(/[^a-z0-9-]/g, "")}`;
const questionId = `${answerId}-question`;
---

<div data-faq-item class="group/faq border-t border-border last:border-b" data-reveal data-reveal-delay={String(delay)}>
  <button
    type="button"
    data-faq-question
    class="group/question flex items-center justify-between w-full gap-4 py-5 border-0 bg-transparent text-foreground font-display text-marketing-small font-semibold leading-[1.35] text-start touch-manipulation transition-colors duration-fast ease-[ease] cursor-pointer hover:text-coral-600 focus-visible:outline-2 focus-visible:outline-lavender-500 focus-visible:outline-offset-[-2px] focus-visible:rounded-[0.35rem]"
    id={questionId}
    aria-expanded="false"
    aria-controls={answerId}
  >
    {question}
    <span
      aria-hidden="true"
      class="text-xl leading-[inherit] font-normal text-coral-500 shrink-0 transition-transform duration-normal ease-pop group-aria-expanded/question:rotate-45"
    >+</span>
  </button>
  <div
    data-faq-body
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-normal ease-reveal motion-reduce:transition-none aria-[hidden=false]:grid-rows-[1fr]"
    role="region"
    id={answerId}
    aria-labelledby={questionId}
    aria-hidden="true"
    inert
  >
    <div class="overflow-hidden">
      <p
        class="opacity-0 max-w-[44rem] pb-5 m-0 text-muted-foreground text-marketing-small leading-marketing-body translate-y-1.5 transition-[opacity,transform,translate] duration-normal ease-[ease] delay-[80ms] group-data-[open=true]/faq:opacity-100 group-data-[open=true]/faq:translate-y-0 [&_a]:text-coral-500 [&_a]:underline [&_a]:decoration-[rgba(242,90,90,0.3)] [&_a]:underline-offset-2 [&_a]:transition-[text-decoration-color] [&_a]:duration-200 [&_a]:hover:decoration-coral-500"
        set:html={answer}
      />
    </div>
  </div>
</div>

<script>
  import { registerPageInitializer } from "../../../lib/pageInitializer";

  function initFaq() {
    const questions = document.querySelectorAll<HTMLButtonElement>("[data-faq-question]");
    if (!questions.length) return;

    const handleFaqClick = (event: Event) => {
      const question = event.currentTarget as HTMLButtonElement;
      const item = question.closest<HTMLElement>("[data-faq-item]");
      const body = item?.querySelector<HTMLElement>("[data-faq-body]");
      if (!item || !body) return;

      const isOpen = question.getAttribute("aria-expanded") !== "true";
      item.dataset.open = String(isOpen);
      question.setAttribute("aria-expanded", String(isOpen));
      body.setAttribute("aria-hidden", String(!isOpen));
      if (isOpen) {
        body.removeAttribute("inert");
      } else {
        body.setAttribute("inert", "");
      }
    };

    questions.forEach((question) => question.addEventListener("click", handleFaqClick));

    return () => {
      questions.forEach((question) => question.removeEventListener("click", handleFaqClick));
    };
  }

  registerPageInitializer("faq:interactions", () => initFaq());
</script>
