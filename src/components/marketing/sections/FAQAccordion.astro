---
import { ChevronDown } from "lucide-astro";

interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
const answerId = `faq-answer-${question
  .toLowerCase()
  .replace(/\s+/g, "-")
  .replace(/[^a-z0-9-]/g, "")}`;
const questionId = `${answerId}-question`;
---

<div data-faq-item class="group/faq border-t border-line first:border-t-0">
  <button
    type="button"
    data-faq-question
    class="group/question flex min-h-11 w-full cursor-pointer touch-manipulation items-center justify-between gap-4 rounded-sm py-6 text-start text-lg font-semibold text-fg transition-colors duration-150 ease-out hover:text-primary focus-visible:-outline-offset-2"
    id={questionId}
    aria-expanded="false"
    aria-controls={answerId}
  >
    {question}
    <ChevronDown
      size={20}
      aria-hidden="true"
      class="shrink-0 text-fg-soft transition-transform duration-300 ease-reveal group-aria-expanded/question:rotate-180"
    />
  </button>
  <div
    data-faq-body
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-reveal motion-reduce:transition-none aria-[hidden=false]:grid-rows-[1fr]"
    role="region"
    id={answerId}
    aria-labelledby={questionId}
    aria-hidden="true"
    inert
  >
    <div class="overflow-hidden">
      <p
        class="max-w-prose translate-y-1.5 pb-6 text-lg text-fg-muted text-pretty opacity-0 transition-[opacity,translate] delay-75 duration-300 ease-out group-data-[open=true]/faq:translate-y-0 group-data-[open=true]/faq:opacity-100"
        set:html={answer}
      />
    </div>
  </div>
</div>

<script>
  import { registerPageInitializer } from "../../../lib/pageInitializer";

  function initFaq() {
    const questions = document.querySelectorAll<HTMLButtonElement>("[data-faq-question]");
    if (!questions.length) return;

    const handleFaqClick = (event: Event) => {
      const question = event.currentTarget as HTMLButtonElement;
      const item = question.closest<HTMLElement>("[data-faq-item]");
      const body = item?.querySelector<HTMLElement>("[data-faq-body]");
      if (!item || !body) return;

      const isOpen = question.getAttribute("aria-expanded") !== "true";
      item.dataset.open = String(isOpen);
      question.setAttribute("aria-expanded", String(isOpen));
      body.setAttribute("aria-hidden", String(!isOpen));
      if (isOpen) {
        body.removeAttribute("inert");
      } else {
        body.setAttribute("inert", "");
      }
    };

    questions.forEach((question) => question.addEventListener("click", handleFaqClick));

    return () => {
      questions.forEach((question) => question.removeEventListener("click", handleFaqClick));
    };
  }

  registerPageInitializer("faq:interactions", () => initFaq());
</script>
