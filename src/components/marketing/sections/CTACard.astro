---
import { ArrowUpRight } from "lucide-astro";
import ButtonLink from "../../ui/ButtonLink.astro";
import { makeHref } from "../../../lib/utils";
import { ROUTES } from "../../../config/constants";

interface Props {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  size?: "default" | "lg";
}

const {
  title = "Try the tool.",
  subtitle = "Choose an image and make the change you need.",
  ctaLabel = "Open the tool",
  ctaHref = makeHref(ROUTES.APP),
  size = "lg",
} = Astro.props;
---

<section class="marketing-cta">
  <div class="marketing-cta-inner" data-reveal>
    <h2>{title}</h2>
    <p>{subtitle}</p>
    <ButtonLink href={ctaHref} size={size}>
      {ctaLabel}
      <ArrowUpRight size={19} strokeWidth={2} aria-hidden="true" />
    </ButtonLink>
  </div>
</section>

<style>
  .marketing-cta {
    position: relative;
    z-index: 1;
    padding: clamp(5rem, 10vw, 9rem) 2rem clamp(6rem, 12vw, 10rem);
    text-align: center;
  }

  .marketing-cta-inner {
    width: min(600px, 100%);
    margin: 0 auto;
  }

  .marketing-cta h2 {
    margin: 0;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: var(--marketing-section-size);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .marketing-cta p {
    max-width: 28rem;
    margin: 1.25rem auto 2rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.65;
  }
</style>
