---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="marketing-page-hero">
  <div class="marketing-page-hero-inner">
    <h1>{title}</h1>
    {subtitle ? <p>{subtitle}</p> : null}
  </div>
</section>

<style>
  .marketing-page-hero {
    position: relative;
    z-index: 1;
    padding: clamp(4.5rem, 9vw, 7.5rem) 2rem clamp(3.5rem, 7vw, 6rem);
  }

  .marketing-page-hero-inner {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .marketing-page-hero h1 {
    max-width: 780px;
    margin: 0;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: var(--marketing-display-size);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.065em;
    text-wrap: balance;
    animation: marketing-hero-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .marketing-page-hero p {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.65;
    animation: marketing-hero-in 700ms 100ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes marketing-hero-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 560px) {
    .marketing-page-hero {
      padding: 3.5rem 1rem 3rem;
    }

    .marketing-page-hero h1 {
      font-size: clamp(2.4rem, 11vw, 3.25rem);
      letter-spacing: -0.06em;
    }

    .marketing-page-hero p {
      margin-top: 1.25rem;
    }
  }
</style>
