---
import MarketingContainer from "../layout/MarketingContainer.astro";

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative z-1 pt-marketing-hero px-marketing-gutter pb-8 marketing-mobile:pt-8 marketing-mobile:px-4 marketing-mobile:pb-6">
  <MarketingContainer>
    <h1 class="max-w-[780px] m-0 text-foreground font-display text-marketing-title-xl font-bold leading-none tracking-marketing-tight text-balance animate-hero-in marketing-mobile:text-marketing-title-mobile">{title}</h1>
    {subtitle ? <p class="max-w-[38rem] mt-6 mb-0 text-muted-foreground text-marketing-body leading-marketing-body animate-hero-in [animation-delay:100ms] marketing-mobile:mt-5">{subtitle}</p> : null}
  </MarketingContainer>
</section>
