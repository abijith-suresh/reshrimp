---
import MarketingContainer from "./MarketingContainer.astro";

type Size = "wide" | "content" | "narrow";

interface Props {
  class?: string;
  size?: Size;
}

const { class: className, size = "wide" } = Astro.props;
---

<MarketingContainer
  size={size}
  class={["marketing-content-container", className].filter(Boolean).join(" ")}
>
  <slot />
</MarketingContainer>
