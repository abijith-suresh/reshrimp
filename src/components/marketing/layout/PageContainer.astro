---
interface Props {
  class?: string;
  children: unknown;
}

const { class: className } = Astro.props;
---

<div class:list={["marketing-content-container", className]}>
  <slot />
</div>

<style>
  .marketing-content-container {
    position: relative;
    z-index: 1;
    width: min(760px, 100%);
    margin: 0 auto;
  }
</style>
