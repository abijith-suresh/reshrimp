---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  size?: "default" | "lg";
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "default",
  external = false,
  class: className,
} = Astro.props;

const secondaryBaseClass =
  "inline-flex items-center gap-2 font-body font-semibold no-underline rounded-sp-full border border-sp-border bg-sp-bg-card text-sp-text transition-all duration-300 shadow-sp hover:translate-y-[-2px] hover:shadow-sp-hover hover:border-sp-lavender";
const secondarySizeClass =
  size === "lg" ? "text-[1rem] py-[0.9rem] px-8" : "text-[0.9rem] py-3 px-6";
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={variant === "primary"
    ? ["cta-pop", { "cta-pop-lg": size === "lg" }, className]
    : [secondaryBaseClass, secondarySizeClass, className]}
>
  <slot />
</a>
