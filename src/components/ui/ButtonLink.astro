---
import { cn } from "../../lib/utils";
import { buttonVariants, type ButtonVariantProps } from "./button";

interface Props extends ButtonVariantProps {
  href: string;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  tone = "coral",
  size = "default",
  fullWidth = false,
  external = false,
  class: className,
} = Astro.props;
---

<a
  data-ui-button
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={cn(buttonVariants({ variant, tone, size, fullWidth }), className)}
>
  <slot />
</a>
