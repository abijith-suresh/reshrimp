---
interface Props {
  sectionClass?: string;
  containerClass?: string;
}

const { sectionClass = "", containerClass } = Astro.props;
---

<section class:list={["marketing-section", sectionClass]}>
  {
    containerClass ? (
      <div class={containerClass}>
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>

<style>
  .marketing-section {
    position: relative;
    z-index: 1;
    padding: var(--marketing-section-space-compact) var(--marketing-gutter)
      var(--marketing-section-space);
  }

  .marketing-section-faq-cta {
    padding-top: 0;
    text-align: center;
  }

  .marketing-narrow-cta {
    width: min(var(--marketing-narrow-width), 100%);
    margin: 0 auto;
  }
</style>
