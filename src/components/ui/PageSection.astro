---
interface Props {
  centered?: boolean;
  containerClass?: string;
}

const { centered = false, containerClass } = Astro.props;
---

<section class:list={["relative z-1 px-marketing-gutter pb-marketing-section", centered ? "pt-0 text-center" : "pt-marketing-section-compact"]}>
  {
    containerClass ? (
      <div class={containerClass}>
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>
