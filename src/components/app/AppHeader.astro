---
import { ROUTES } from "../../config/constants";
import { makeHref } from "../../lib/utils";
import Logo from "../shared/Logo.astro";
---

<header
  class="sticky top-0 z-100 bg-[rgba(248,247,255,0.85)] backdrop-blur-[16px] border-b border-sp-border-light"
  transition:animate="fade"
>
  <nav class="max-w-[1100px] mx-auto flex justify-between items-center px-8 py-2.5">
    <a
      href={makeHref(ROUTES.HOME)}
      class="flex items-center justify-center w-8 h-8 text-sp-text-muted rounded-sp-full no-underline transition-all duration-200 hover:text-sp-text hover:bg-sp-border-light"
      aria-label="Back to home"
    >
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 12H5m0 0l6-6m-6 6l6 6"></path>
      </svg>
    </a>

    <Logo href={ROUTES.APP} />

    <div class="w-8"></div>
  </nav>
</header>
