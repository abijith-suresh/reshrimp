---
import { SITE_NAME } from "../../config/constants";
import { makeHref } from "../../lib/utils";

interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a
  href={makeHref(href)}
  class="group/logo inline-flex min-h-11 items-center gap-2 rounded-sm font-display text-title-sm text-fg no-underline"
>
  <span
    class="size-2.5 shrink-0 rounded-full bg-coral transition-transform duration-300 ease-pop group-hover/logo:scale-140"
  ></span>
  {SITE_NAME.toLowerCase()}
</a>
