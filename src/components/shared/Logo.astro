---
const { href = "/" } = Astro.props;
import { makeHref } from "../../lib/utils";
import { SITE_NAME } from "../../config/constants";
---

<a href={makeHref(href)} class="group/logo flex items-center gap-2 font-display text-[1.2rem] font-bold text-foreground no-underline transition-opacity duration-200 hover:opacity-80">
  <span class="size-2.5 rounded-full bg-coral-500 shrink-0 transition-transform duration-normal ease-pop group-hover/logo:scale-140"></span>
  {SITE_NAME.toLowerCase()}
</a>
