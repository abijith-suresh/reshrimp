---
import { SITE_NAME } from "../../config/constants";
import { makeHref } from "../../lib/utils";
import BrandMark from "./BrandMark";

interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a
  href={makeHref(href)}
  aria-label={`${SITE_NAME} home`}
  class="group/logo inline-flex min-h-11 items-center gap-2 rounded-sm font-display text-title-sm text-fg no-underline"
>
  <BrandMark class="transition-transform duration-300 ease-pop group-hover/logo:-rotate-8" />
  <span translate="no">{SITE_NAME.toLowerCase()}</span>
</a>
