---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div class="sp-section-header text-center">
  <span
    class="block text-[0.8rem] font-semibold text-sp-lavender-dark uppercase tracking-[0.08em] mb-2"
    >{label}</span
  >
  <h2
    class="font-display text-[clamp(1.6rem,3.5vw,2.4rem)] font-extrabold leading-[1.2] m-0 mb-12 tracking-tight"
  >
    {title}
  </h2>
</div>
