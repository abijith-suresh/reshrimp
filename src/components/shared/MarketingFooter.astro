---
import { GITHUB_URL, ROUTES, SITE_NAME } from "../../config/constants";
import { makeHref } from "../../lib/utils";
import Container from "../marketing/layout/Container.astro";
import { buttonVariants } from "../ui/button";
import Logo from "./Logo.astro";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const footerLinks: FooterLink[] = [
  { label: "Privacy", href: makeHref(ROUTES.PRIVACY) },
  { label: "FAQ", href: makeHref(ROUTES.FAQ) },
  { label: "GitHub", href: GITHUB_URL, external: true },
];
---

<footer class="border-t border-line">
  <Container class="flex items-center justify-between gap-6 py-6 marketing-mobile:flex-col marketing-mobile:items-start marketing-mobile:gap-3">
    <div class="flex items-center gap-4">
      <Logo />
      <span class="text-sm text-fg-soft">&copy; {new Date().getFullYear()} {SITE_NAME}</span>
    </div>
    <nav class="-mx-3 flex flex-wrap items-center gap-1" aria-label="Footer navigation">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class={buttonVariants({ variant: "ghost", size: "sm" })}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </Container>
</footer>
