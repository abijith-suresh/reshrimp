---
import { GITHUB_URL, SITE_NAME, ROUTES } from "../../config/constants";
import { makeHref } from "../../lib/utils";
import MarketingContainer from "../marketing/layout/MarketingContainer.astro";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const footerLinks: FooterLink[] = [
  { label: "Privacy", href: makeHref(ROUTES.PRIVACY) },
  { label: "About", href: makeHref(ROUTES.ABOUT) },
  { label: "FAQ", href: makeHref(ROUTES.FAQ) },
  { label: "GitHub", href: GITHUB_URL, external: true },
];
---

<footer class="footer">
  <MarketingContainer size="wide">
    <div class="footer-inner">
      <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} {SITE_NAME}</span>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="footer-link"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </MarketingContainer>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-light);
    padding: var(--space-8) var(--marketing-gutter);
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2) var(--space-5);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--space-10);
    font-size: var(--marketing-small-size);
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
    touch-action: manipulation;
  }

  .footer-link:hover {
    color: var(--coral-500);
  }

  .footer-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.4);
    border-radius: 4px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    font-size: var(--marketing-caption-size);
    color: var(--soft-foreground);
  }

  @media (max-width: 560px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-4);
    }

    .footer-links {
      justify-content: flex-start;
    }
  }
</style>
