---
import { GITHUB_URL, ROUTES, SITE_NAME } from "../../config/constants";
import { makeHref } from "../../lib/utils";
import Container from "../marketing/layout/Container.astro";
import Logo from "./Logo.astro";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const footerColumns: { title: string; links: FooterLink[] }[] = [
  {
    title: "Product",
    links: [
      { label: "Open the app", href: makeHref(ROUTES.APP) },
      { label: "Privacy", href: makeHref(ROUTES.PRIVACY) },
      { label: "FAQ", href: makeHref(ROUTES.FAQ) },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: GITHUB_URL, external: true },
      { label: "Report an issue", href: `${GITHUB_URL}/issues`, external: true },
    ],
  },
];
---

<footer class="border-t border-line">
  <Container class="flex justify-between gap-12 py-12 marketing-menu:flex-col marketing-menu:gap-10 marketing-mobile:py-10">
    <div class="max-w-xs">
      <Logo />
      <p class="mt-2 text-base text-fg-muted text-pretty">
        Resize, compress, and convert images without uploading them.
      </p>
      <p class="mt-6 text-sm text-fg-soft">&copy; {new Date().getFullYear()} {SITE_NAME}</p>
    </div>
    <nav class="grid grid-cols-[auto_auto] gap-x-16 gap-y-8 marketing-mobile:gap-x-12" aria-label="Footer navigation">
      {
        footerColumns.map((column) => (
          <div>
            <p class="text-sm font-semibold text-fg">{column.title}</p>
            <ul class="mt-3 grid gap-1">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class="-mx-1 inline-flex min-h-8 items-center rounded-xs px-1 text-sm text-fg-muted no-underline transition-colors duration-150 ease-out hover:text-fg pointer-coarse:min-h-11"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </Container>
</footer>
