---
// Reusable floating background blobs for marketing pages
---

<div class="pop-shapes" aria-hidden="true">
  <div class="pop-shape shape-1"></div>
  <div class="pop-shape shape-2"></div>
  <div class="pop-shape shape-3"></div>
</div>

<style>
  .pop-shapes {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(circle at 8% 4%, var(--coral-50), transparent 26%),
      radial-gradient(circle at 94% 16%, var(--lavender-50), transparent 28%),
      radial-gradient(circle at 54% 100%, var(--mint-50), transparent 30%);
  }

  .pop-shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(26px);
    opacity: 0.38;
    will-change: transform;
  }

  .shape-1 {
    width: min(30vw, 360px);
    height: min(30vw, 360px);
    top: -8%;
    right: 4%;
    background: var(--coral-100);
    animation: soft-drift 18s ease-in-out infinite;
  }

  .shape-2 {
    width: min(24vw, 280px);
    height: min(24vw, 280px);
    top: 58%;
    left: -7%;
    background: var(--mint-100);
    animation: soft-drift 22s 2s ease-in-out infinite reverse;
  }

  .shape-3 {
    width: min(18vw, 220px);
    height: min(18vw, 220px);
    top: 34%;
    left: 34%;
    background: var(--lavender-100);
    animation: soft-drift 16s 1s ease-in-out infinite;
  }

  @keyframes soft-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.3;
    }
    50% {
      transform: translate3d(0, 12px, 0) scale(1.08);
      opacity: 0.48;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pop-shape {
      animation: none;
    }
  }
</style>
