---
import { ROUTES } from "../../config/constants";
import { makeHref } from "../../lib/utils";
import MarketingContainer from "../marketing/layout/MarketingContainer.astro";
import Logo from "./Logo.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const headerLinks = [{ label: "About", href: ROUTES.ABOUT }];
---

<header class="sticky top-0 z-100 bg-background border-b border-border-light transition-[box-shadow,border-color] duration-fast ease-[ease] data-[scrolled=true]:shadow-xs data-[scrolled=true]:border-border" id="header" transition:animate="none">
  <MarketingContainer>
    <nav class="w-full flex justify-between items-center py-3 px-marketing-gutter marketing-menu:px-4">
    <Logo />

    <div class="flex items-center gap-2 marketing-menu:hidden">
      {
        headerLinks.map((link) => (
          <a
            href={makeHref(link.href)}
            class="text-marketing-small font-medium text-muted-foreground no-underline py-2 px-3 rounded-md transition-colors duration-200 ease-[ease] touch-manipulation hover:text-foreground hover:bg-border-light focus-visible:outline-none focus-visible:shadow-[0_0_0_2px_rgba(167,139,250,0.4)] aria-[current=page]:text-coral-700 aria-[current=page]:font-semibold aria-[current=page]:bg-coral-50"
            aria-current={currentPath === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href={makeHref(ROUTES.APP)} class="inline-flex items-center justify-center min-h-10 px-4 rounded-md bg-coral-500 text-white text-marketing-small font-semibold no-underline shadow-sm transition-[background-color,box-shadow,transform,scale] duration-fast ease-[ease] touch-manipulation [-webkit-tap-highlight-color:transparent] hover:bg-coral-600 active:scale-98 active:shadow-2xs focus-visible:outline-2 focus-visible:outline-lavender-500 focus-visible:outline-offset-3">Use Reshrimp</a>
    </div>

    <button
      type="button"
      class="group/menu relative hidden cursor-pointer text-foreground bg-transparent border-none p-1 rounded-md transition-[background-color,transform,scale] duration-fast ease-[ease] [-webkit-tap-highlight-color:transparent] hover:bg-card active:scale-96 marketing-menu:flex marketing-menu:items-center marketing-menu:justify-center marketing-menu:size-10 focus-visible:outline-none focus-visible:shadow-[0_0_0_2px_rgba(167,139,250,0.4)]"
      id="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
    >
      <svg
        class="absolute inset-0 m-auto transition-[opacity,transform,scale,rotate] duration-fast ease-[ease,cubic-bezier(0.2,0.8,0.2,1),cubic-bezier(0.2,0.8,0.2,1),cubic-bezier(0.2,0.8,0.2,1)] group-aria-expanded/menu:opacity-0 group-aria-expanded/menu:scale-70 group-aria-expanded/menu:rotate-8"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        class="absolute inset-0 m-auto transition-[opacity,transform,scale,rotate] duration-fast ease-[ease,cubic-bezier(0.2,0.8,0.2,1),cubic-bezier(0.2,0.8,0.2,1),cubic-bezier(0.2,0.8,0.2,1)] opacity-0 scale-70 -rotate-8 group-aria-expanded/menu:opacity-100 group-aria-expanded/menu:scale-100 group-aria-expanded/menu:rotate-0"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
    </nav>
  </MarketingContainer>

  <div class="absolute top-full inset-x-0 invisible overflow-hidden pointer-events-none opacity-0 -translate-y-2 bg-background border-b border-border-light shadow-sm transition-[opacity,transform,translate,visibility] duration-[300ms,300ms,300ms,0s] ease-[var(--ease-reveal),var(--ease-reveal),var(--ease-reveal),linear] delay-[0s,0s,0s,300ms] aria-[hidden=false]:visible aria-[hidden=false]:pointer-events-auto aria-[hidden=false]:opacity-100 aria-[hidden=false]:translate-y-0 aria-[hidden=false]:delay-0" id="mobile-menu-panel" aria-hidden="true" inert>
    <div class="flex flex-col gap-1 pt-2 px-marketing-gutter pb-6">
      {
        headerLinks.map((link) => (
          <a
            href={makeHref(link.href)}
            class="text-marketing-small font-medium text-muted-foreground no-underline py-2 px-3 rounded-md transition-colors duration-fast ease-[ease] touch-manipulation hover:text-foreground hover:bg-card focus-visible:outline-none focus-visible:shadow-[0_0_0_2px_rgba(167,139,250,0.4)] focus-visible:rounded-[4px] aria-[current=page]:text-coral-500 aria-[current=page]:font-semibold"
            aria-current={currentPath === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href={makeHref(ROUTES.APP)} class="text-marketing-small font-semibold text-white no-underline py-2 px-3 rounded-md transition-colors duration-fast ease-[ease] touch-manipulation mt-2 bg-coral-500 text-center hover:text-white hover:bg-coral-600 focus-visible:outline-none focus-visible:shadow-[0_0_0_2px_rgba(167,139,250,0.4)] focus-visible:rounded-[4px]">Use Reshrimp</a>
    </div>
  </div>
</header>

<script>
  import { registerPageInitializer } from "../../lib/pageInitializer";

  function initMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const panel = document.getElementById("mobile-menu-panel");
    if (!btn || !panel) return;

    const setMenuOpen = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.setAttribute("aria-hidden", String(!open));
      if (open) {
        panel.removeAttribute("inert");
      } else {
        panel.setAttribute("inert", "");
      }
    };

    const closeMenu = () => {
      setMenuOpen(false);
    };

    const toggleMenu = () => {
      setMenuOpen(panel.getAttribute("aria-hidden") !== "false");
    };

    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && panel.getAttribute("aria-hidden") === "false") {
        closeMenu();
        btn.focus();
      }
    };

    closeMenu();
    btn.addEventListener("click", toggleMenu);
    document.addEventListener("keydown", handleKeyDown);

    return () => {
      btn.removeEventListener("click", toggleMenu);
      document.removeEventListener("keydown", handleKeyDown);
      closeMenu();
    };
  }

  function initHeaderScroll(isSpaNavigation: boolean) {
    const header = document.getElementById("header");
    if (!header) return;

    const update = () => {
      header.dataset.scrolled = String(window.scrollY > 8);
    };

    // Only set initial state on first page load.
    // On SPA navigation Astro resets scroll to 0, so the scrolled state
    // should already be removed by the cleanup below.
    if (!isSpaNavigation) {
      update();
    }

    window.addEventListener("scroll", update, { passive: true });

    return () => {
      window.removeEventListener("scroll", update);
      delete header.dataset.scrolled;
    };
  }

  registerPageInitializer("marketing-header:interactions", (isSpaNavigation) => {
    const cleanups = [initMobileMenu(), initHeaderScroll(isSpaNavigation)].filter(
      (cleanup): cleanup is () => void => typeof cleanup === "function"
    );

    return () => {
      cleanups.forEach((cleanup) => cleanup());
    };
  });
</script>
