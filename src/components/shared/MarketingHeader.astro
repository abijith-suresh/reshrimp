---
import { Github, Menu, X } from "lucide-astro";
import { GITHUB_URL, ROUTES } from "../../config/constants";
import { cn, makeHref } from "../../lib/utils";
import Container from "../marketing/layout/Container.astro";
import ButtonLink from "../ui/ButtonLink.astro";
import { buttonVariants } from "../ui/button";
import Logo from "./Logo.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const headerLinks = [
  { label: "Privacy", href: ROUTES.PRIVACY },
  { label: "FAQ", href: ROUTES.FAQ },
];
const ariaCurrent = (href: string) => (currentPath === href ? "page" : undefined);
---

<header
  id="header"
  transition:animate="none"
  class="sticky top-0 z-100 border-b border-line bg-surface transition-shadow duration-150 data-[scrolled=true]:shadow-sm"
>
  <Container>
    <nav class="relative flex h-16 items-center justify-between gap-4" aria-label="Main">
      <Logo />

      <div class="flex items-center gap-1">
        <div class="flex items-center gap-1 marketing-menu:hidden">
          {
            headerLinks.map((link) => (
              <a
                href={makeHref(link.href)}
                class={buttonVariants({ variant: "ghost", size: "sm" })}
                aria-current={ariaCurrent(link.href)}
              >
                {link.label}
              </a>
            ))
          }
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Reshrimp on GitHub"
            class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "w-9 px-0 pointer-coarse:w-11")}
          >
            <Github size={18} aria-hidden="true" />
          </a>
        </div>
        <ButtonLink href={makeHref(ROUTES.APP)} size="sm" class="ms-2 marketing-menu:hidden">
          Open Reshrimp
        </ButtonLink>

        <button
          type="button"
          class="group/menu relative hidden size-11 cursor-pointer items-center justify-center rounded-md bg-surface text-fg-muted shadow-button transition-[background-color,color,scale] duration-150 ease-out hover:bg-surface-muted hover:text-fg active:scale-96 aria-expanded:bg-surface-muted aria-expanded:text-fg marketing-menu:inline-flex"
          id="mobile-menu-btn"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
        >
          <Menu
            size={20}
            aria-hidden="true"
            class="absolute transition-[opacity,scale] duration-150 ease-out group-aria-expanded/menu:scale-75 group-aria-expanded/menu:opacity-0"
          />
          <X
            size={20}
            aria-hidden="true"
            class="absolute scale-75 opacity-0 transition-[opacity,scale] duration-150 ease-out group-aria-expanded/menu:scale-100 group-aria-expanded/menu:opacity-100"
          />
        </button>
      </div>

      <div
        id="mobile-menu-panel"
        class="invisible absolute top-full right-0 mt-2 grid w-56 origin-top-right -translate-y-1 scale-98 gap-1 rounded-lg border border-line bg-surface p-2 opacity-0 shadow-md transition-[opacity,translate,scale,visibility] duration-150 ease-out aria-[hidden=false]:visible aria-[hidden=false]:translate-y-0 aria-[hidden=false]:scale-100 aria-[hidden=false]:opacity-100"
        aria-hidden="true"
        inert
      >
        {
          headerLinks.map((link) => (
            <a
              href={makeHref(link.href)}
              class="flex min-h-11 items-center rounded-md px-3 text-base text-fg-muted no-underline transition-colors duration-150 ease-out hover:bg-hover hover:text-fg focus-visible:-outline-offset-2 aria-[current=page]:bg-selected aria-[current=page]:font-semibold aria-[current=page]:text-fg"
              aria-current={ariaCurrent(link.href)}
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-11 items-center justify-between rounded-md px-3 text-base text-fg-muted no-underline transition-colors duration-150 ease-out hover:bg-hover hover:text-fg focus-visible:-outline-offset-2"
        >
          GitHub
          <Github size={18} aria-hidden="true" class="text-fg-soft" />
        </a>
        <div class="mt-1 grid">
          <ButtonLink href={makeHref(ROUTES.APP)}>Open Reshrimp</ButtonLink>
        </div>
      </div>
    </nav>
  </Container>
</header>

<script>
  import { registerPageInitializer } from "../../lib/pageInitializer";

  function initMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const panel = document.getElementById("mobile-menu-panel");
    if (!btn || !panel) return;

    const setMenuOpen = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.setAttribute("aria-hidden", String(!open));
      if (open) {
        panel.removeAttribute("inert");
      } else {
        panel.setAttribute("inert", "");
      }
    };

    const closeMenu = () => {
      setMenuOpen(false);
    };

    const toggleMenu = () => {
      setMenuOpen(panel.getAttribute("aria-hidden") !== "false");
    };

    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && panel.getAttribute("aria-hidden") === "false") {
        closeMenu();
        btn.focus();
      }
    };

    closeMenu();
    btn.addEventListener("click", toggleMenu);
    document.addEventListener("keydown", handleKeyDown);

    return () => {
      btn.removeEventListener("click", toggleMenu);
      document.removeEventListener("keydown", handleKeyDown);
      closeMenu();
    };
  }

  function initHeaderScroll(isSpaNavigation: boolean) {
    const header = document.getElementById("header");
    if (!header) return;

    const update = () => {
      header.dataset.scrolled = String(window.scrollY > 8);
    };

    // Only set initial state on first page load.
    // On SPA navigation Astro resets scroll to 0, so the scrolled state
    // should already be removed by the cleanup below.
    if (!isSpaNavigation) {
      update();
    }

    window.addEventListener("scroll", update, { passive: true });

    return () => {
      window.removeEventListener("scroll", update);
      delete header.dataset.scrolled;
    };
  }

  registerPageInitializer("marketing-header:interactions", (isSpaNavigation) => {
    const cleanups = [initMobileMenu(), initHeaderScroll(isSpaNavigation)].filter(
      (cleanup): cleanup is () => void => typeof cleanup === "function"
    );

    return () => {
      cleanups.forEach((cleanup) => cleanup());
    };
  });
</script>
