---
import { ROUTES } from "../../config/constants";
import { makeHref } from "../../lib/utils";
import MarketingContainer from "../marketing/layout/MarketingContainer.astro";
import Logo from "./Logo.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const headerLinks = [{ label: "About", href: ROUTES.ABOUT }];
---

<header class="header" id="header" transition:animate="none">
  <MarketingContainer size="wide">
    <nav class="header-inner">
    <Logo />

    <div class="nav-desktop">
      {
        headerLinks.map((link) => (
          <a
            href={makeHref(link.href)}
            class:list={["nav-link", { "nav-link-active": currentPath === link.href }]}
          >
            {link.label}
          </a>
        ))
      }
      <a href={makeHref(ROUTES.APP)} class="header-cta">Use Reshrimp</a>
    </div>

    <button
      type="button"
      class="hamburger"
      id="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
    >
      <svg
        class="hamburger-icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        class="close-icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
    </nav>
  </MarketingContainer>

  <div class="mobile-panel" id="mobile-menu-panel" aria-hidden="true" inert>
    <div class="mobile-panel-inner">
      {
        headerLinks.map((link) => (
          <a
            href={makeHref(link.href)}
            class:list={["mobile-link", { "mobile-link-active": currentPath === link.href }]}
          >
            {link.label}
          </a>
        ))
      }
      <a href={makeHref(ROUTES.APP)} class="mobile-link mobile-link-cta">Use Reshrimp</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--marketing-shell-surface);
    border-bottom: 1px solid var(--border-light);
    transition:
      box-shadow var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .header.scrolled {
    box-shadow: var(--shadow-xs);
    border-bottom-color: var(--border);
  }

  .header-inner {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--marketing-gutter);
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-link {
    font-size: var(--marketing-small-size);
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
    position: relative;
    touch-action: manipulation;
  }

  .nav-link:hover {
    color: var(--foreground);
    background: var(--border-light);
  }

  .nav-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.4);
  }

  .nav-link-active {
    color: var(--coral-700);
    font-weight: 600;
    background: var(--coral-50);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--space-10);
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    background: var(--coral-500);
    color: white;
    font-size: var(--marketing-small-size);
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      background-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease,
      transform var(--duration-fast) ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .header-cta:hover {
    background: var(--coral-600);
    box-shadow: var(--shadow-sm);
  }

  .header-cta:active {
    transform: scale(0.98);
    box-shadow: var(--shadow-2xs);
  }

  .header-cta:focus-visible {
    outline: 2px solid var(--lavender-500);
    outline-offset: 3px;
  }

  .hamburger {
    position: relative;
    display: none;
    cursor: pointer;
    color: var(--foreground);
    background: none;
    border: none;
    padding: var(--space-1);
    border-radius: var(--radius-md);
    transition:
      background-color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
    -webkit-tap-highlight-color: transparent;
  }

  .hamburger:hover {
    background: var(--card);
  }

  .hamburger:active {
    transform: scale(0.96);
  }

  .hamburger-icon,
  .close-icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-fast) cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .close-icon {
    opacity: 0;
    transform: scale(0.7) rotate(-8deg);
  }

  .hamburger[aria-expanded="true"] .hamburger-icon {
    opacity: 0;
    transform: scale(0.7) rotate(8deg);
  }

  .hamburger[aria-expanded="true"] .close-icon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  .mobile-panel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    visibility: hidden;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-0.5rem);
    background: var(--marketing-shell-surface);
    border-bottom: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition:
      opacity var(--duration-normal) cubic-bezier(0.22, 1, 0.36, 1),
      transform var(--duration-normal) cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear var(--duration-normal);
  }

  .mobile-panel.mobile-open {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity var(--duration-normal) cubic-bezier(0.22, 1, 0.36, 1),
      transform var(--duration-normal) cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  .mobile-panel-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2) var(--marketing-gutter) var(--space-6);
  }

  .mobile-link {
    font-size: var(--marketing-small-size);
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
    touch-action: manipulation;
  }

  .mobile-link:hover {
    color: var(--foreground);
    background: var(--card);
  }

  .mobile-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.4);
    border-radius: 4px;
  }

  .mobile-link-active {
    color: var(--coral-500);
    font-weight: 600;
  }

  .mobile-link-cta {
    margin-top: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--coral-500);
    color: white;
    text-align: center;
    font-weight: 600;
  }

  .mobile-link-cta:hover {
    color: white;
    background: var(--coral-600);
  }

  @media (max-width: 768px) {
    .header-inner {
      padding-right: var(--space-4);
      padding-left: var(--space-4);
    }

    .nav-desktop {
      display: none;
    }

    .hamburger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: none;
      background: none;
      cursor: pointer;
      border-radius: var(--radius-md);
      padding: var(--space-1);
      color: var(--foreground);
      touch-action: manipulation;
    }

    .hamburger:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.4);
    }
  }
</style>

<script>
  import { registerPageInitializer } from "../../lib/pageInitializer";

  function initMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const panel = document.getElementById("mobile-menu-panel");
    if (!btn || !panel) return;

    const setMenuOpen = (open: boolean) => {
      panel.classList.toggle("mobile-open", open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.setAttribute("aria-hidden", String(!open));
      if (open) {
        panel.removeAttribute("inert");
      } else {
        panel.setAttribute("inert", "");
      }
    };

    const closeMenu = () => {
      setMenuOpen(false);
    };

    const toggleMenu = () => {
      setMenuOpen(!panel.classList.contains("mobile-open"));
    };

    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && panel.classList.contains("mobile-open")) {
        closeMenu();
        btn.focus();
      }
    };

    closeMenu();
    btn.addEventListener("click", toggleMenu);
    document.addEventListener("keydown", handleKeyDown);

    return () => {
      btn.removeEventListener("click", toggleMenu);
      document.removeEventListener("keydown", handleKeyDown);
      closeMenu();
    };
  }

  function initHeaderScroll(isSpaNavigation: boolean) {
    const header = document.getElementById("header");
    if (!header) return;

    const update = () => {
      header.classList.toggle("scrolled", window.scrollY > 8);
    };

    // Only set initial state on first page load.
    // On SPA navigation Astro resets scroll to 0, so the scrolled class
    // should already be removed by the cleanup below.
    if (!isSpaNavigation) {
      update();
    }

    window.addEventListener("scroll", update, { passive: true });

    return () => {
      window.removeEventListener("scroll", update);
      header.classList.remove("scrolled");
    };
  }

  registerPageInitializer("marketing-header:interactions", (isSpaNavigation) => {
    const cleanups = [initMobileMenu(), initHeaderScroll(isSpaNavigation)].filter(
      (cleanup): cleanup is () => void => typeof cleanup === "function"
    );

    return () => {
      cleanups.forEach((cleanup) => cleanup());
    };
  });
</script>
