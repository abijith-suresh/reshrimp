---
import { GITHUB_URL, ROUTES } from "../../config/constants";
import { makeHref } from "../../lib/utils";
import Logo from "./Logo.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const headerLinks = [
  { label: "Features", href: ROUTES.FEATURES },
  { label: "Privacy", href: ROUTES.PRIVACY },
  { label: "About", href: ROUTES.ABOUT },
];
---

<header class="header" id="header" transition:animate="none">
  <nav class="header-inner">
    <Logo />

    <div class="nav-desktop">
      {
        headerLinks.map((link) => (
          <a
            href={makeHref(link.href)}
            class:list={["nav-link", { "nav-link-active": currentPath === link.href }]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-link nav-github"
        aria-label="View on GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
      </a>
      <a href={makeHref(ROUTES.APP)} class="header-cta">Use Reshrimp</a>
    </div>

    <button
      type="button"
      class="hamburger"
      id="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
    >
      <svg
        class="hamburger-icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        class="close-icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </nav>

  <div class="mobile-panel" id="mobile-menu-panel" aria-hidden="true" inert>
    <div class="mobile-panel-inner">
      {
        headerLinks.map((link) => (
          <a
            href={makeHref(link.href)}
            class:list={["mobile-link", { "mobile-link-active": currentPath === link.href }]}
          >
            {link.label}
          </a>
        ))
      }
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="mobile-link">
        GitHub
      </a>
      <a href={makeHref(ROUTES.APP)} class="mobile-link mobile-link-cta">Use Reshrimp</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--card);
    border-bottom: 1px solid var(--border-light);
    transition:
      box-shadow var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .header.scrolled {
    box-shadow: var(--shadow-xs);
    border-bottom-color: var(--border);
  }

  .header-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 2rem;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
    position: relative;
    touch-action: manipulation;
  }

  .nav-link:hover {
    color: var(--foreground);
    background: var(--border-light);
  }

  .nav-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.4);
  }

  .nav-link-active {
    color: var(--coral-700);
    font-weight: 600;
    background: var(--coral-50);
  }

  .nav-github {
    display: flex;
    align-items: center;
    padding: 0.5rem;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: var(--radius-md);
    background: var(--coral-500);
    color: white;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      background-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease,
      transform var(--duration-fast) ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .header-cta:hover {
    background: var(--coral-600);
    box-shadow: var(--shadow-sm);
  }

  .header-cta:active {
    transform: scale(0.98);
    box-shadow: var(--shadow-2xs);
  }

  .header-cta:focus-visible {
    outline: 2px solid var(--lavender-500);
    outline-offset: 3px;
  }

  .hamburger {
    position: relative;
    display: none;
    cursor: pointer;
    color: var(--foreground);
    background: none;
    border: none;
    padding: 0.25rem;
    border-radius: var(--radius-md);
    transition:
      background-color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
    -webkit-tap-highlight-color: transparent;
  }

  .hamburger:hover {
    background: var(--background);
  }

  .hamburger:active {
    transform: scale(0.96);
  }

  .hamburger-icon,
  .close-icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-fast) cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .close-icon {
    opacity: 0;
    transform: scale(0.7) rotate(-8deg);
  }

  .hamburger[aria-expanded="true"] .hamburger-icon {
    opacity: 0;
    transform: scale(0.7) rotate(8deg);
  }

  .hamburger[aria-expanded="true"] .close-icon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  .mobile-panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    background: var(--card);
    border-bottom: 1px solid transparent;
    transition:
      grid-template-rows var(--duration-normal) cubic-bezier(0.22, 1, 0.36, 1),
      border-color var(--duration-fast) ease;
  }

  .mobile-panel.mobile-open {
    grid-template-rows: 1fr;
    border-bottom-color: var(--border-light);
  }

  .mobile-panel-inner {
    display: flex;
    min-height: 0;
    flex-direction: column;
    gap: 0.25rem;
    overflow: hidden;
    padding: 0 2rem;
    transition: padding var(--duration-normal) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-panel.mobile-open .mobile-panel-inner {
    padding-top: 0.5rem;
    padding-bottom: 1.5rem;
  }

  .mobile-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-md);
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
    touch-action: manipulation;
  }

  .mobile-link:hover {
    color: var(--foreground);
    background: var(--background);
  }

  .mobile-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.4);
    border-radius: 4px;
  }

  .mobile-link-active {
    color: var(--coral-500);
    font-weight: 600;
  }

  .mobile-link-cta {
    margin-top: 0.5rem;
    border-radius: var(--radius-md);
    background: var(--coral-500);
    color: white;
    text-align: center;
    font-weight: 600;
  }

  .mobile-link-cta:hover {
    color: white;
    background: var(--coral-600);
  }

  @media (max-width: 768px) {
    .header-inner {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .nav-desktop {
      display: none;
    }

    .hamburger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: none;
      background: none;
      cursor: pointer;
      border-radius: var(--radius-md);
      padding: 4px;
      color: var(--foreground);
      touch-action: manipulation;
    }

    .hamburger:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.4);
    }
  }
</style>

<script>
  import { registerPageInitializer } from "../../lib/pageInitializer";

  function initMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const panel = document.getElementById("mobile-menu-panel");
    if (!btn || !panel) return;

    const setMenuOpen = (open: boolean) => {
      panel.classList.toggle("mobile-open", open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.setAttribute("aria-hidden", String(!open));
      if (open) {
        panel.removeAttribute("inert");
      } else {
        panel.setAttribute("inert", "");
      }
    };

    const closeMenu = () => {
      setMenuOpen(false);
    };

    const toggleMenu = () => {
      setMenuOpen(!panel.classList.contains("mobile-open"));
    };

    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && panel.classList.contains("mobile-open")) {
        closeMenu();
        btn.focus();
      }
    };

    closeMenu();
    btn.addEventListener("click", toggleMenu);
    document.addEventListener("keydown", handleKeyDown);

    return () => {
      btn.removeEventListener("click", toggleMenu);
      document.removeEventListener("keydown", handleKeyDown);
      closeMenu();
    };
  }

  function initHeaderScroll(isSpaNavigation: boolean) {
    const header = document.getElementById("header");
    if (!header) return;

    const update = () => {
      header.classList.toggle("scrolled", window.scrollY > 8);
    };

    // Only set initial state on first page load.
    // On SPA navigation Astro resets scroll to 0, so the scrolled class
    // should already be removed by the cleanup below.
    if (!isSpaNavigation) {
      update();
    }

    window.addEventListener("scroll", update, { passive: true });

    return () => {
      window.removeEventListener("scroll", update);
      header.classList.remove("scrolled");
    };
  }

  registerPageInitializer("marketing-header:interactions", (isSpaNavigation) => {
    const cleanups = [initMobileMenu(), initHeaderScroll(isSpaNavigation)].filter(
      (cleanup): cleanup is () => void => typeof cleanup === "function"
    );

    return () => {
      cleanups.forEach((cleanup) => cleanup());
    };
  });
</script>
