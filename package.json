{
  "name": "reshrimp",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "version": "0.0.6",
  "scripts": {
    "assets:background-removal": "node scripts/sync-background-removal-assets.mjs",
    "predev": "bun run assets:background-removal",
    "dev": "astro dev",
    "prebuild": "bun run assets:background-removal",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && astro check && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:asset-sync": "node --test scripts/sync-background-removal-assets.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true bun run build",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test:coverage && bun run test:asset-sync && bun run build",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:build": "bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "^7.1.2",
    "@imgly/background-removal": "^1.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.7",
    "heic2any": "^0.0.4",
    "lucide-astro": "^0.556.0",
    "lucide-solid": "^1.70.0",
    "onnxruntime-web": "1.31.1",
    "satori": "^0.63.2",
    "solid-js": "^1.9.18"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.24",
    "browserslist": "4.29.0",
    "fflate": "0.7.5",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "protobufjs": "7.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
