{
  "name": "reshrimp",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "version": "0.7.3",
  "scripts": {
    "assets:background-removal": "node scripts/sync-background-removal-assets.mjs",
    "predev": "bun run assets:background-removal",
    "dev": "astro dev",
    "prebuild": "bun run assets:background-removal",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true bun run build",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/solid-js": "^7.0.1",
    "@imgly/background-removal": "^1.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.1.3",
    "heic2any": "^0.0.4",
    "lucide-astro": "^0.556.0",
    "lucide-solid": "^1.27.0",
    "satori": "^0.29.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@vite-pwa/astro": "^1.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
