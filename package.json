{
  "name": "reshrimp",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "version": "0.0.1",
  "scripts": {
    "assets:background-removal": "node scripts/sync-background-removal-assets.mjs",
    "predev": "bun run assets:background-removal",
    "dev": "astro dev",
    "prebuild": "bun run assets:background-removal",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && astro check && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true bun run build",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test:coverage && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "^7.0.2",
    "@imgly/background-removal": "^1.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.2",
    "heic2any": "^0.0.4",
    "lucide-astro": "^0.556.0",
    "lucide-solid": "^1.44.0",
    "satori": "^0.33.4",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  }
}
